# Copia este archivo como .env (está en .gitignore) y rellena los valores.

# Reseñas de Google en la home. Clave de Google Cloud con «Places API (New)»
# activada; restríngela por API para que no valga para otros servicios.
GOOGLE_PLACES_API_KEY=

# Opcional. Si se deja vacío, la ficha se busca por nombre y dirección.
GOOGLE_PLACE_ID=

# Formulario de cita. Id del endpoint de Formspree (la parte final de
# https://formspree.io/f/XXXXXXXX). Es público: viaja en el HTML. Sin él el
# formulario avisa de que no está configurado y ofrece teléfono y correo.
PUBLIC_FORMSPREE_ID=
