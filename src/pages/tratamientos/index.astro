---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE, CONTACTO } from '../../data/site';
import { TRATAMIENTOS } from '../../data/tratamientos';

import esteticaImg from '../../assets/sonris/tratamientos/Estetica-Dental-1.webp';
import implantesImg from '../../assets/sonris/tratamientos/Implantes-Dentales-1.webp';
import ortognaticaImg from '../../assets/sonris/tratamientos/Cirugia-Ortognatica-1.webp';
import endodonciaImg from '../../assets/sonris/tratamientos/Endodoncia-1.webp';
import cirugiaOralImg from '../../assets/sonris/tratamientos/Cirugia-Oral-img-7675.webp';
import periodonciaImg from '../../assets/sonris/tratamientos/Peridonicia-3.webp';
import odontologiaImg from '../../assets/sonris/tratamientos/Odontologia-General-2.webp';

// Una foto por tratamiento, distinta de la que usa el carrusel de la home.
const FOTOS: Record<string, ImageMetadata> = {
  'estetica-dental': esteticaImg,
  'implantes-dentales': implantesImg,
  'cirugia-ortognatica': ortognaticaImg,
  endodoncia: endodonciaImg,
  'cirugia-oral': cirugiaOralImg,
  periodoncia: periodonciaImg,
  'odontologia-general': odontologiaImg,
};

const ruta = '/tratamientos/';

const listaLd = {
  '@type': 'ItemList',
  '@id': `${SITE.url}${ruta}#lista`,
  name: 'Tratamientos de Sonris',
  numberOfItems: TRATAMIENTOS.length,
  itemListElement: TRATAMIENTOS.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.nombre,
    url: `${SITE.url}/tratamientos/${t.slug}/`,
  })),
};
---

<Base
  titulo="Sonris | Tratamientos"
  descripcion="Estética dental, implantes, cirugía ortognática, endodoncia, cirugía oral, periodoncia y odontología general, alrededor de la ortodoncia invisible. Sanchinarro, Madrid."
  {ruta}
  migas={[{ nombre: 'Tratamientos', href: ruta }]}
  jsonLd={[listaLd]}
>
  <section
    id="tratamientos"
    aria-labelledby="hero-t"
    style="position:relative;overflow:hidden;background:linear-gradient(180deg,#FFFFFF 0%,rgba(254,225,203,0.45) 100%);padding:56px 0 96px"
  >
    <div
      aria-hidden="true"
      style="position:absolute;top:-200px;right:-140px;width:600px;height:480px;border-radius:9999px;background:#FEE1CB;filter:blur(80px);opacity:0.55;animation:sonris-float 22s ease-in-out infinite"
    >
    </div>
    <div style="position:relative;max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-hero style="display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:56px;align-items:end">
        <div>
          <h1
            data-h1
            style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:700;font-size:60px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:20ch"
          >
            Todo lo que tu boca puede <span style="color:#EB6B0A">necesitar</span>
          </h1>
          <p id="hero-t" style="margin:0;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:60ch">
            Nuestra especialidad es la ortodoncia invisible, y a su alrededor tratamos lo que hace falta para que el tratamiento salga bien.
            Entra en cada uno para ver cómo trabajamos.
          </p>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
          <a
            data-primary
            href="#formulario"
            style="display:inline-flex;flex:none;white-space:nowrap;align-items:center;gap:12px;min-height:56px;padding:0 30px;border-radius:9999px;background:#B24E00;color:#FFFFFF;font-size:17px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
            >Pide tu primera visita<span data-arrow style="display:inline-block;transition:transform 300ms cubic-bezier(0.22,1,0.36,1)">→</span></a
          >
          <p style="margin:0;font-size:16px;color:#6B6B6B">Gratuita y sin compromiso.</p>
        </div>
      </div>
    </div>
  </section>

  <section data-sec aria-labelledby="rejilla-t" style="background:#F7F7F7;padding:112px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <h2
        id="rejilla-t"
        style="margin:0 0 64px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:40px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
      >
        Siete tratamientos, una sola clínica
      </h2>

      {
        TRATAMIENTOS.map((t, i) => {
          const textoIzquierda = i % 2 === 0;
          const figura = (
            <figure style={`margin:0;grid-column:${textoIzquierda ? 2 : 1};grid-row:1`}>
              <div style="position:relative;aspect-ratio:4/3;border-radius:40px;overflow:hidden;background:repeating-linear-gradient(135deg,#F7F7F7 0 14px,#EFEFEF 14px 28px);box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06)">
                <Image
                  src={FOTOS[t.slug]}
                  widths={[600, 1000]}
                  sizes="(max-width:900px) 100vw, 50vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  alt={`${t.nombre} en Sonris`}
                  style="width:100%;height:100%;object-fit:cover;display:block"
                />
              </div>
            </figure>
          );
          const texto = (
            <div style={`grid-column:${textoIzquierda ? 1 : 2};grid-row:1`}>
              <h3 style="margin:0 0 18px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:40px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:16ch">
                {t.nombre}
              </h3>
              <p style="margin:0 0 14px;font-size:20px;line-height:1.4;color:#1A1A1A;max-width:34ch">{t.claim}</p>
              <p style="margin:0 0 32px;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:52ch">{t.resumenHub}</p>
              <a
                data-underline
                href={`/tratamientos/${t.slug}/`}
                style="display:inline-flex;align-items:center;gap:10px;font-size:17px;font-weight:500;color:#1A1A1A"
              >
                Ver {t.nombre.toLowerCase()} <span>→</span>
              </a>
            </div>
          );
          return (
            <article
              id={t.slug}
              data-zig
              style={`scroll-margin-top:96px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:72px;align-items:center;padding:${i === 0 ? '0' : '80px 0 0'}`}
            >
              {textoIzquierda ? texto : figura}
              {textoIzquierda ? figura : texto}
            </article>
          );
        })
      }
    </div>
  </section>

  <section data-sec id="formulario" aria-labelledby="cta-t" style="padding:112px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div
        data-peach
        data-cta-caja
        style="background:#FEE1CB;border-radius:40px;padding:56px;display:flex;flex-wrap:wrap;gap:32px;align-items:center;justify-content:space-between"
      >
        <div>
          <h2
            id="cta-t"
            style="margin:0 0 12px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:40px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
          >
            Cuéntanos qué te preocupa
          </h2>
          <p style="margin:0;font-size:17px;line-height:1.7;color:#1A1A1A;max-width:52ch">
            Primera visita gratuita, sin compromiso. {CONTACTO.horario}, en {CONTACTO.calle}.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:14px">
          <a
            data-primary
            href="/contacto/#formulario"
            style="display:inline-flex;white-space:nowrap;align-items:center;gap:12px;min-height:56px;padding:0 32px;border-radius:9999px;background:#B24E00;color:#FFFFFF;font-size:17px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
            >Pide tu cita<span data-arrow style="display:inline-block;transition:transform 300ms cubic-bezier(0.22,1,0.36,1)">→</span></a
          >
          <p style="margin:0;font-size:16px;color:#1A1A1A">
            o llámanos al <a href={`tel:${CONTACTO.telefonoE164}`} style="color:#B24E00;font-weight:500">{CONTACTO.telefono}</a>
          </p>
        </div>
      </div>

      <p style="margin:32px 0 0;font-size:17px;line-height:1.7;color:#6B6B6B">
        ¿Ya te has tratado con nosotros? Consulta las{' '}
        <a data-underline href="/indicaciones-post-tratamiento/" style="color:#1A1A1A;font-weight:500">
          indicaciones post-tratamiento
        </a>{' '}
        para los días siguientes a la intervención.
      </p>
    </div>
  </section>
</Base>
