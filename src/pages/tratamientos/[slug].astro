---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { SITE } from '../../data/site';
import { TRATAMIENTOS, type Tratamiento } from '../../data/tratamientos';
import odontologiaHero from '../../assets/sonris/tratamientos/Odontologia-General-Ozkan.webp';
import periodonciaHero from '../../assets/sonris/tratamientos/Periodoncia-Ozkan.webp';
import cirugiaOralHero from '../../assets/sonris/tratamientos/Cirugia-Oral-Angels.webp';
import esteticaHero from '../../assets/sonris/tratamientos/Estetica-Dental-Ozkan.webp';
import ortognaticaHero from '../../assets/sonris/tratamientos/Cirugia-Ortognatica-Render.webp';
import endodonciaHero from '../../assets/sonris/tratamientos/Endodoncia-Render.webp';

// Foto de cabecera por tratamiento, la misma que su tarjeta en la home y en el
// hub. Implantes dentales es el único que sigue con el fondo liso, así que
// darle la suya es una línea en este mapa.
const HEROS: Record<string, ImageMetadata> = {
  'odontologia-general': odontologiaHero,
  periodoncia: periodonciaHero,
  'cirugia-oral': cirugiaOralHero,
  'estetica-dental': esteticaHero,
  'cirugia-ortognatica': ortognaticaHero,
  endodoncia: endodonciaHero,
};

export function getStaticPaths() {
  return TRATAMIENTOS.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}

const { t } = Astro.props as { t: Tratamiento };
const ruta = `/tratamientos/${t.slug}/`;
const hero = HEROS[t.slug];

// Pestañas y variantes se pintan igual, uno debajo de otro. Ningún tratamiento
// llena las dos listas; concatenar evita tener que elegir.
const bloques = [...t.pestanas, ...t.variantes];

const procedimientoLd = {
  '@type': 'MedicalProcedure',
  '@id': `${SITE.url}${ruta}#procedimiento`,
  name: t.nombre,
  description: t.queEs1,
  howPerformed: t.queEs2,
  provider: { '@id': `${SITE.url}/#clinica` },
};
---

<Base
  titulo={`Sonris | ${t.nombre}`}
  descripcion={`${t.entradilla} ${t.nombre} en Sonris, Avenida Isabel de Valois 55, Madrid. Primera visita gratuita.`}
  {ruta}
  migas={[
    { nombre: 'Tratamientos', href: '/tratamientos/' },
    { nombre: t.nombre, href: ruta },
  ]}
  jsonLd={[procedimientoLd]}
>
  <section id="inicio" aria-labelledby="hero-t" style="position:relative;overflow:hidden;background:#000000">
    <div data-herobox style="position:relative;width:100%;aspect-ratio:16/9;max-height:88vh;overflow:hidden">
      {
        hero ? (
          <Image
            src={hero}
            alt={`${t.nombre} en la clínica Sonris`}
            width={1600}
            height={900}
            loading="eager"
            fetchpriority="high"
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block"
          />
        ) : (
          <img
            src="/img/placeholder-liso-16x9.png"
            alt={`${t.nombre} en la clínica Sonris`}
            width="1600"
            height="900"
            fetchpriority="high"
            decoding="async"
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block"
          />
        )
      }
      <div
        aria-hidden="true"
        style="position:absolute;inset:0;background:rgba(0,0,0,0.62);background-image:linear-gradient(180deg,rgba(0,0,0,0.1) 0%,rgba(0,0,0,0.25) 55%,rgba(0,0,0,0.55) 100%)"
      >
      </div>
      <div
        data-herotexto
        style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:0 40px 96px"
      >
        <div style="max-width:1240px;width:100%;margin:0 auto">
          <h1
            data-h1
            id="hero-t"
            style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:700;font-size:60px;line-height:1.05;letter-spacing:-0.02em;color:#FFFFFF;max-width:16ch"
          >
            {t.h1}
          </h1>
          <p style="margin:0 0 28px;font-size:19px;line-height:1.6;color:rgba(255,255,255,0.88);max-width:46ch">{t.entradilla}</p>
          <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
            <a
              data-primary
              href="/contacto/#formulario"
              style="display:inline-flex;flex:none;white-space:nowrap;align-items:center;gap:12px;min-height:56px;padding:0 32px;border-radius:9999px;background:#E76B0B;color:#FFFFFF;font-size:18.66px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
              >Pide tu cita<span data-arrow style="display:inline-block;transition:transform 300ms cubic-bezier(0.22,1,0.36,1)">→</span></a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <div data-overlap style="position:relative;z-index:5;max-width:1240px;margin:-64px auto 0;padding:0 40px">
    <div style="background:#FFFFFF;border-radius:40px;box-shadow:0 4px 12px rgba(0,0,0,.06),0 24px 56px rgba(0,0,0,.10);padding:20px 24px">
      <nav aria-label="Elige el tratamiento">
        <ul style="margin:0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:10px">
          {
            TRATAMIENTOS.map((o) => (
              <li>
                <a
                  href={`/tratamientos/${o.slug}/`}
                  aria-current={o.slug === t.slug ? 'page' : undefined}
                  style={`display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:9999px;background:${o.slug === t.slug ? '#FEE1CB' : '#FFFFFF'};border:${o.slug === t.slug ? '2px solid #E76B0B' : '1px solid rgba(0,0,0,0.08)'};color:#1A1A1A;font-size:15px;font-weight:500`}
                >
                  {o.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <section
    data-sec
    data-band-gray
    data-overlap-pull
    id="que-es"
    aria-labelledby="que-t"
    style="background:#F7F7F7;padding:176px 0 128px;margin-top:-64px"
  >
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:64px;align-items:start">
        <div>
          <h2
            data-h2-grande
            id="que-t"
            style="margin:0;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:20ch"
          >
            {t.queEsTitulo}
          </h2>
        </div>
        <div>
          <p style="margin:0 0 18px;font-size:18px;line-height:1.7;color:#1A1A1A;max-width:65ch">{t.queEs1}</p>
          <p style="margin:0;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:65ch">{t.queEs2}</p>
        </div>
      </div>
    </div>
  </section>

  <section
    data-sec
    data-textura
    id="tipos"
    aria-labelledby="tipos-t"
    style="background-color:#FFFFFF;--velo:rgba(255,255,255,0.88);padding:128px 0"
  >
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <h2
        data-h2-grande
        id="tipos-t"
        style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:24ch"
      >
        {t.tiposTitulo}
      </h2>
      <p style="margin:0 0 48px;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:65ch">{t.tiposEntradilla}</p>

      {/* Zigzag: cada panel deja aire a un lado, alternando. En móvil el ancho
          vuelve al 100% desde global.css. */}
      <div data-cascada style="display:flex;flex-direction:column;gap:24px">
        {
          bloques.map((v, i) => (
            <article
              data-caja
              id={v.id}
              style={`background:#F7F7F7;border-radius:40px;padding:44px;scroll-margin-top:120px;width:88%;align-self:${i % 2 === 0 ? 'flex-start' : 'flex-end'}`}
            >
              <h3 style="margin:0 0 16px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:28px;line-height:1.2;letter-spacing:-0.02em;color:#000000">
                {v.nombre}
              </h3>
              <p style="margin:0;font-size:18px;line-height:1.7;color:#1A1A1A;max-width:65ch">{v.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section data-sec id="beneficios" data-peach aria-labelledby="ben-t" style="background:#FEE1CB;padding:104px 0 128px;border-radius:40px">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <h2
        data-h2-grande
        id="ben-t"
        style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
      >
        Qué ganas viniendo aquí
      </h2>
      <p style="margin:0 0 48px;font-size:18px;line-height:1.7;color:#1A1A1A;max-width:65ch">
        Tres cosas que valen para cualquier tratamiento que hagas con nosotros.
      </p>
      <div data-3col style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px">
        {
          /* Sin icono: los 76px extra de padding superior (56 del cuadro + 20 de
             su margen) mantienen la card a la altura y el texto en el sitio de antes. */
          [
            ['Primera visita gratuita', 'Valoramos tu caso sin compromiso, y decides después.'],
            ['Plan y presupuesto por escrito', 'Sabes qué se va a hacer y qué cuesta antes de empezar.'],
            ['Todo en la misma clínica', 'En Avenida Isabel de Valois 55, con el mismo equipo de siempre.'],
          ].map(([titulo, texto]) => (
            <article style="background:#FFFFFF;border-radius:40px;padding:108px 32px 32px;box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06)">
              <h3 style="margin:0 0 12px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;letter-spacing:-0.02em;color:#000000">
                {titulo}
              </h3>
              <p style="margin:0;font-size:16px;line-height:1.7;color:#6B6B6B">{texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section data-sec id="cruce" aria-labelledby="cruce-t" style="padding:112px 0 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div
        data-2col
        data-caja style="display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:48px;align-items:center;background:#F7F7F7;border-radius:40px;padding:56px"
      >
        <div>
          <h2
            id="cruce-t"
            style="margin:0 0 14px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:36px;line-height:1.15;letter-spacing:-0.02em;color:#000000;max-width:20ch"
          >
            {t.cruce.titulo}
          </h2>
          <p style="margin:0;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:52ch">{t.cruce.texto}</p>
        </div>
        <!-- Los dos enlaces comparten fila; envuelven solos si la etiqueta del
             cruce es larga o la caja se estrecha. -->
        <div style="display:flex;flex-wrap:wrap;gap:16px 24px;align-items:center">
          <a
            data-primary
            href={t.cruce.href}
            style="display:inline-flex;white-space:nowrap;align-items:center;gap:12px;min-height:56px;padding:0 32px;border-radius:9999px;background:#E76B0B;color:#FFFFFF;font-size:18.66px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
            >{t.cruce.etiqueta}<span data-arrow style="display:inline-block;transition:transform 300ms cubic-bezier(0.22,1,0.36,1)">→</span></a
          >
          <a data-underline href="/tratamientos/" style="display:inline-flex;align-items:center;gap:8px;font-size:16px;font-weight:500;color:#1A1A1A"
            >Ver todos<span class="vh"> los tratamientos</span> <span>→</span></a
          >
        </div>
      </div>
    </div>
  </section>

  <CtaFinal />
</Base>
