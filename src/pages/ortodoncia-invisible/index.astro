  <CtaFinal />

  <script>
    // El vídeo propio va sin descarga, sin PiP y sin cambio de velocidad:
    // deja reproducir, pausar y el volumen. No impide guardar el archivo desde
    // la URL, solo quita los atajos de la interfaz. Con el DOM y no con
    // innerHTML: título y portada se editan desde el modo edición, y unas
    // comillas romperían los atributos.
    function crearMedio(src: string, titulo: string, poster = '') {
      let medio: HTMLElement;
      if (/\.(mp4|webm)$/.test(src)) {
        const video = Object.assign(document.createElement('video'), {
          src,
          poster,
          controls: true,
          autoplay: true,
          playsInline: true,
          disablePictureInPicture: true,
        });
        video.setAttribute('aria-label', titulo);
        video.setAttribute('controlsList', 'nodownload noplaybackrate noremoteplayback');
        video.addEventListener('contextmenu', (e) => e.preventDefault());
        medio = video;
      } else {
        const marco = Object.assign(document.createElement('iframe'), { src, title: titulo, allowFullscreen: true });
        marco.allow = 'autoplay; encrypted-media; fullscreen';
        medio = marco;
      }
      return medio;
    }

    // «Cómo ponerse el alineador»: se reproduce en su propia caja, en el sitio
    // de la portada. El botón no se borra, se oculta: el modo edición lo usa
    // para cambiar el vídeo (data-video, data-poster).
    document.querySelectorAll<HTMLButtonElement>('button[data-video]').forEach((el) => {
      el.addEventListener('click', () => {
        const video = crearMedio(el.dataset.video as string, el.dataset.titulo as string, el.dataset.poster);
        video.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block';
        const caja = document.createElement('div');
        caja.style.cssText = el.style.cssText;
        caja.style.cursor = '';
        caja.style.background = '#000000';
        caja.append(video);
        el.style.display = 'none';
        el.after(caja);
        video.focus();
      });
    });

    // El card entero abre el vídeo; el enlace de dentro sigue siendo el camino
    // por teclado y el fallback a YouTube sin JS.
    document.querySelectorAll<HTMLElement>('[data-feat]').forEach((card) => {
      const enlace = card.querySelector<HTMLElement>('[data-video]');
      if (!enlace) return;
      card.addEventListener('click', (e) => {
        if (!enlace.contains(e.target as Node)) enlace.click();
      });
    });

    // Tecnología: la primera vez, las tarjetas se apilan a la izquierda como
    // selectores y el vídeo ocupa la columna ancha. Cambiar de tarjeta cambia
    // el vídeo; ✕ vuelve a las tres en fila. startViewTransition anima el
    // cambio de distribución donde existe; donde no, cambia sin más.
    const tec = document.querySelector<HTMLElement>('[data-tec]');
    if (tec) {
      const visor = tec.querySelector<HTMLElement>('[data-tec-visor]')!;
      const tecSlot = tec.querySelector<HTMLElement>('[data-tec-slot]')!;
      const enlaces = Array.from(tec.querySelectorAll<HTMLAnchorElement>('[data-video]'));
      const cambiar = (fn: () => void) =>
        'startViewTransition' in document && !matchMedia('(prefers-reduced-motion: reduce)').matches
          ? (document as any).startViewTransition(fn)
          : fn();
      enlaces.forEach((el) =>
        el.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey) return;
          e.preventDefault();
          if (el.getAttribute('aria-current') === 'true') return;
          cambiar(() => {
            enlaces.forEach((x) => x.removeAttribute('aria-current'));
            el.setAttribute('aria-current', 'true');
            tecSlot.replaceChildren(crearMedio(el.dataset.video as string, el.dataset.titulo as string));
            visor.hidden = false;
            tec.setAttribute('data-abierto', '');
          });
          // En móvil el visor va arriba: que no quede fuera de pantalla.
          if (matchMedia('(max-width: 900px)').matches) visor.scrollIntoView({ behavior: 'smooth', block: 'center' });
        })
      );
      tec.querySelector('[data-tec-cerrar]')!.addEventListener('click', () => {
        const activo = enlaces.find((x) => x.getAttribute('aria-current') === 'true');
        cambiar(() => {
          enlaces.forEach((x) => x.removeAttribute('aria-current'));
          tecSlot.innerHTML = '';
          visor.hidden = true;
          tec.removeAttribute('data-abierto');
        });
        activo?.focus();
      });
    }


  </script>
</Base>
