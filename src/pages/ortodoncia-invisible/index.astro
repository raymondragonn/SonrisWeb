        </div>
        <aside
          style={`background-color:#F7F7F7;background-image:url(${fondoPruebas.src});background-size:cover;background-position:center;border-radius:40px;padding:36px`}
          {...fondo('ortodoncia.pruebas.fondo', fondoPruebas)}
        >
          <h3 style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:22px;letter-spacing:-0.02em;color:#000000">
