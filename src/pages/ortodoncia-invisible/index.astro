        <div>
          <h2
            data-h2-grande
            id="pv-t"
            style="margin:0 0 40px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:46px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:20ch"
          >
            <Cms k="ortodoncia.visita.titulo">Tu primera visita es</Cms> <span style="color:#E76B0B"><Cms k="ortodoncia.visita.titulo-acento">GRATUITA</Cms></span>
          </h2>
          <ol style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:16px">
            {
              PRIMERA_VISITA.map((texto, i) => (
