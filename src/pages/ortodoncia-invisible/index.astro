---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import pequesImg from '../../assets/sonris/blog/ortodoncia-invisible-para-los-mas-pequenos-1024x675-1.jpg';
import ninosImg from '../../assets/sonris/blog/ventajas-de-la-ortodoncia-invisible-en-ninos-1080x675-1.jpg';
import cajaIronMan from '../../assets/sonris/tratamientos/Producto-Caja-Iron-Man.png';
import cajaStitch from '../../assets/sonris/tratamientos/Producto-Caja-Stitch.png';
import fondoMemphis from '../../assets/sonris/iconos/fondo-memphis-tratamientos.png';
import CtaFinal from '../../components/CtaFinal.astro';
import CarruselPlanes from '../../islands/CarruselPlanes';
import Acordeon from '../../islands/Acordeon';
import { SITE } from '../../data/site';
import fondoLima from '../../assets/sonris/iconos/fondo-memphis-lima.png';
import fondoRosa from '../../assets/sonris/iconos/fondo-memphis-rosa.png';
import { VENTAJAS, PLANES, PASOS_CLINICOS, TECNOLOGIA, PRIMERA_VISITA, PRUEBAS_INCLUIDAS, FAQ } from '../../data/ortodoncia';

const ruta = '/ortodoncia-invisible/';

// La textura memphis va de fondo de la tarjeta de pruebas: se sirve del mismo
// archivo que las secciones grandes, reducido a lo que ocupa la caja.
const fondoPruebas = await getImage({ src: fondoMemphis, width: 900, format: 'webp' });

// Las ventajas van de cuatro en cuatro: cada grupo es una página del carrusel.
const POR_PAGINA = 4;
const paginasVentajas = Array.from({ length: Math.ceil(VENTAJAS.length / POR_PAGINA) }, (_, i) =>
  VENTAJAS.slice(i * POR_PAGINA, (i + 1) * POR_PAGINA),
);

const [lima, rosa] = await Promise.all([
  getImage({ src: fondoLima, width: 1672, format: 'webp' }),
  getImage({ src: fondoRosa, width: 1672, format: 'webp' }),
]);

// Los vídeos vienen en los dos formatos de URL de YouTube (youtu.be/ID y
// watch?v=ID); el ID es el último trozo en ambos.
const incrustar = (url: string) =>
  `https://www.youtube-nocookie.com/embed/${url.split(/[/=]/).pop()}?autoplay=1&rel=0`;

// Solo entran en el FAQPage las preguntas con respuesta real.
const faqLd = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}${ruta}#faq`,
  mainEntity: FAQ.filter((f) => f.respuesta).map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};

const procedimientoLd = {
  '@type': 'MedicalProcedure',
  '@id': `${SITE.url}${ruta}#procedimiento`,
  name: 'Ortodoncia invisible con alineadores transparentes',
  alternateName: ['Alineadores transparentes', 'Ortodoncia invisible'],
  procedureType: 'https://schema.org/NoninvasiveProcedure',
  bodyLocation: 'Boca',
  howPerformed:
    'Alineadores transparentes hechos a medida que corrigen problemas oclusales y de posición dental. El juego se cambia cada una o dos semanas y se lleva entre 21 y 22 horas diarias.',
  preparation:
    'Primera visita gratuita con exploración, radiografía panorámica, radiografía lateral de cráneo, fotografías intra y extraorales, escáner intraoral 3D iTero y simulación virtual.',
  provider: { '@id': `${SITE.url}/#clinica` },
};

const anclas = [
  ['#que-es', 'Qué son'],
  ['#tipos', 'Tipos de tratamiento'],
  ['#como-funciona', 'Cómo funciona'],
  ['#tecnologia', 'Tecnología'],
  ['#primera-visita', 'Primera visita'],
  ['#faq', 'Preguntas frecuentes'],
];
---

<Base
  titulo="Sonris | Ortodoncia invisible"
  descripcion="Alineadores transparentes en Sanchinarro, Madrid. Cinco planes de tratamiento, escáner iTero, Dental Monitoring y primera visita gratuita con la Dra. Isabel Vélez."
  {ruta}
  migas={[{ nombre: 'Ortodoncia invisible', href: ruta }]}
  jsonLd={[procedimientoLd, faqLd]}
>
  <section id="inicio" aria-labelledby="hero-t" style="position:relative;overflow:hidden;background:#000000">
    <div
      data-herobox
      data-alineador
      style="position:relative;width:100%;aspect-ratio:16/9;max-height:88vh;overflow:hidden"
    >
      <div data-giro style="position:absolute;inset:0;pointer-events:none">
        <video
          src="/video/alineador-giro.mp4"
          poster="/img/alineador-poster.webp"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label="Simulación del movimiento dental de un tratamiento de ortodoncia"
          style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block"></video>
      </div>
      <div
        aria-hidden="true"
        style="position:absolute;inset:0;background-image:linear-gradient(180deg,rgba(0,0,0,0.1) 0%,rgba(0,0,0,0.25) 55%,rgba(0,0,0,0.55) 100%)"
      >
      </div>
      <div
        data-herotexto
        style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:0 40px 96px"
      >
        <div style="max-width:1240px;width:100%;margin:0 auto">
          <h1
            data-h1
            id="hero-t"
            style="margin:0 0 28px;font-family:Poppins,system-ui,sans-serif;font-weight:700;font-size:68px;line-height:1.05;letter-spacing:-0.02em;color:#FFFFFF;max-width:14ch"
          >
            Sonríe sin preocuparte de <span style="color:#E76B0B">nada</span>
          </h1>
          <div data-botonera style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
            <a
              data-primary
              href="/contacto/"
              style="display:inline-flex;flex:none;white-space:nowrap;align-items:center;gap:12px;min-height:56px;padding:0 32px;border-radius:9999px;background:#E76B0B;color:#FFFFFF;font-size:18.66px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
              >Empieza por la valoración</a
            >
            <a
              href="#que-es"
              style="display:inline-flex;flex:none;white-space:nowrap;align-items:center;min-height:56px;padding:0 28px;border-radius:9999px;background:rgba(0,0,0,0.55);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.7);color:#FFFFFF;font-size:17px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1)"
              >Cómo funciona</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <nav data-overlap data-solo-ancha aria-label="Secciones de esta página" style="position:relative;z-index:5;max-width:1240px;margin:-64px auto 0;padding:0 40px">
    <div style="background:#FFFFFF;border-radius:40px;box-shadow:0 4px 12px rgba(0,0,0,.06),0 24px 56px rgba(0,0,0,.10);padding:20px 24px">
      <ul style="margin:0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:10px">
        {anclas.map(([href, nombre]) => (
          <li style="flex:1 1 auto">
            <a href={href} style="width:100%;justify-content:center;white-space:nowrap;display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:9999px;background:#FFFFFF;border:1px solid rgba(0,0,0,0.08);color:#1A1A1A;font-size:15px;font-weight:500">
              {nombre}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <section
    data-sec
    data-band-gray
    data-overlap-pull
    id="que-es"
    aria-labelledby="que-t"
    style="background:#F7F7F7;padding:176px 0 128px;margin-top:-64px"
  >
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:64px;align-items:start;margin-bottom:64px">
        <div>
          <h2
            data-h2-grande
            id="que-t"
            style="margin:0;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:46px;line-height:1.1;letter-spacing:-0.02em;color:#000000"
          >
            ¿Qué son los <span style="color:#E76B0B">alineadores</span>?
          </h2>
        </div>
        <div>
          <p style="margin:0 0 18px;font-size:18px;line-height:1.7;color:#1A1A1A;max-width:65ch">
            Son férulas transparentes hechas a medida que corrigen problemas oclusales y de posición dental. El tratamiento se planifica
            paso a paso, así que puedes visualizar el resultado antes de empezar.
          </p>
          <p style="margin:0;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:65ch">
            Según la dificultad del caso, el juego se cambia cada una o dos semanas y se lleva un mínimo de 22 horas diarias.
          </p>
        </div>
      </div>
      <div
        data-auto-carrusel="5000"
        aria-label="Ventajas de los alineadores"
        style="display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none"
      >
        {
          paginasVentajas.map((pagina) => (
            <div style="flex:0 0 100%;scroll-snap-align:start;display:flex;flex-wrap:wrap;gap:10px;justify-content:center;align-content:flex-start">
              {pagina.map(([titulo, texto]) => (
                <span style="display:inline-flex;align-items:center;gap:8px;background:#FFFFFF;border:1px solid rgba(0,0,0,0.08);border-radius:9999px;padding:10px 18px;font-size:15px;line-height:1.4;color:#6B6B6B;box-shadow:0 2px 8px rgba(0,0,0,.04)">
                  <strong style="font-weight:600;color:#1A1A1A">{titulo}</strong> {texto}
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section data-sec id="tipos" aria-labelledby="tipos-t" style="padding:128px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <h2
        data-h2-grande
        id="tipos-t"
        style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:46px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:24ch"
      >
        Cinco planes, según lo que necesite tu caso
      </h2>
      <p style="margin:0 0 56px;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:65ch">
        Cuál te corresponde se decide en la primera visita, después de la exploración y las pruebas. El precio se te da entonces, por escrito.
      </p>

      <CarruselPlanes client:visible planes={PLANES} />

      <p style="margin:32px auto 0;font-size:17px;line-height:1.7;color:#6B6B6B;max-width:65ch;text-align:center">
        ¿Cuál es el mío? Lo decidimos juntos en la primera visita, con las pruebas delante. No hace falta que lo sepas antes de venir.
        <a data-underline href="#primera-visita" style="color:#1A1A1A;font-weight:500">Ver cómo es la primera visita →</a>
      </p>
    </div>
  </section>

  <section
    data-sec
    aria-labelledby="ninos-t"
    style={`background-color:#CFD173;background-image:url(${lima.src});background-size:cover;background-position:center;padding:112px 0;border-radius:40px`}
  >
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:64px;align-items:center">
        <figure style="margin:0;position:relative">
          <div
            style="position:relative;aspect-ratio:1/1;border-radius:40px;overflow:hidden;background:rgba(255,255,255,.5);display:flex;align-items:center;justify-content:center;padding:32px"
          >
            <Image
              src={pequesImg}
              widths={[440, 880]}
              sizes="(max-width:900px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              alt="Dos niños sosteniendo sus alineadores transparentes"
              style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block"
            />
            <!-- Se releva con la de arriba cada 10 s (sonris-turno). Va con alt
                 vacío a propósito: cuenta lo mismo que la primera, y anunciar
                 las dos duplicaría el mensaje en el lector de pantalla. -->
            <Image
              data-turno
              src={ninosImg}
              widths={[440, 880]}
              sizes="(max-width:900px) 100vw, 40vw"
              loading="lazy"
              decoding="async"
              alt=""
              style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block"
            />
          </div>
          <div data-cajacard="sup-der">
            <Image
              src={cajaIronMan}
              widths={[200, 400]}
              sizes="(max-width:900px) 32vw, 150px"
              loading="lazy"
              decoding="async"
              alt=""
              aria-hidden="true"
            />
          </div>
          <div data-cajacard="inf-izq">
            <Image
              src={cajaStitch}
              widths={[200, 400]}
              sizes="(max-width:900px) 32vw, 150px"
              loading="lazy"
              decoding="async"
              alt=""
              aria-hidden="true"
            />
          </div>
        </figure>
        <div>
          <h2
            data-h2-grande
            id="ninos-t"
            style="margin:0 0 32px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:42px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
          >
            También hay alineadores para los más pequeños
          </h2>
          <div data-2col data-apretado style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
            <div style="background:#FFFFFF;border-radius:40px;padding:32px">
              <h3
                style="margin:0 0 12px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:22px;letter-spacing:-0.02em;color:#000000"
              >
                Alineadores para niños
              </h3>
              <p style="margin:0;font-size:16px;line-height:1.7;color:#1A1A1A">
                Niños de 3 a 16 años. Ortodoncia interceptiva, de 6 meses a año y medio.
              </p>
            </div>
            <div style="background:#FFFFFF;border-radius:40px;padding:32px">
              <h3
                style="margin:0 0 12px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:22px;letter-spacing:-0.02em;color:#000000"
              >
                Alineadores para adolescentes
              </h3>
              <p style="margin:0;font-size:16px;line-height:1.7;color:#1A1A1A">
                Adolescentes de 16 a 19 años. Correctiva, con indicadores de cumplimiento visibles para padres y ortodoncista.
              </p>
            </div>
          </div>
          <a
            href="https://eu.smilemate.com/practice/848ddca1-7c21-4ddd-b158-7fb0f2cfec40"
            target="_blank"
            rel="noopener noreferrer"
            data-cta-largo
            style="position:relative;margin-top:24px;display:inline-flex;align-items:center;gap:10px;min-height:56px;padding:0 26px;border-radius:9999px;background:#FFFFFF;color:#1A1A1A;font-size:17px;font-weight:600"
            >Valora tu caso con una foto <span>→</span><span class="vh"> (se abre en una pestaña nueva)</span></a
          >
        </div>
      </div>
    </div>
  </section>

  <section data-sec id="como-funciona" aria-labelledby="como-t" style="padding:128px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <h2
        data-h2-grande
        id="como-t"
        style="margin:0 0 56px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:46px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
      >
        Cinco pasos, en este orden
      </h2>
      <div data-2col style="display:grid;grid-template-columns:minmax(0,6fr) minmax(0,6fr);gap:64px;align-items:start">
        <ol data-pasos style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px">
          {
            PASOS_CLINICOS.map((p, i) => (
              <li
                style={`display:flex;gap:24px;padding:28px 0${i < PASOS_CLINICOS.length - 1 ? ';border-bottom:1px solid rgba(0,0,0,0.08)' : ''}`}
              >
                <span
                  aria-hidden="true"
                  style="flex:none;width:56px;height:56px;border-radius:20px;background:#E76B0B;color:#FFFFFF;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:22px;display:flex;align-items:center;justify-content:center"
                >
                  {i + 1}
                </span>
                <div>
                  <h3 style="margin:0 0 8px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;letter-spacing:-0.02em;color:#000000">
                    {p.titulo}
                  </h3>
                  <p style="margin:0;font-size:17px;line-height:1.7;color:#6B6B6B;max-width:60ch">{p.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div style="background:#F7F7F7;border-radius:40px;padding:28px">
          <h3 style="margin:0 0 8px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;letter-spacing:-0.02em;color:#000000">
            Cómo ponerse el alineador
          </h3>
          <p style="margin:0 0 20px;font-size:16px;line-height:1.7;color:#6B6B6B">Un minuto de vídeo.</p>
          <!-- El cartel lleva la proporción exacta de la portada (758x1158), no
               la del vídeo: así se ve entera y sin recorte, que es lo que pide
               un fotograma con el alineador en la mano. El ancho se acota a
               320px porque a ancho de columna el alto se disparaba y
               desequilibraba la fila. El vídeo se reproduce en el modal. -->
          <button
            type="button"
            data-video="/video/Cecilia-PONER-ALINEADOR.mp4"
            data-titulo="Cómo ponerse el alineador"
            style="position:relative;display:block;width:100%;max-width:320px;margin:0 auto;aspect-ratio:758/1158;padding:0;border:0;border-radius:28px;overflow:hidden;background:#EFEFEF;cursor:pointer"
          >
            <img
              src="/img/portada-alineador.webp"
              width="758"
              height="1158"
              loading="lazy"
              decoding="async"
              alt=""
              aria-hidden="true"
              style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block"
            />
            <span
              aria-hidden="true"
              style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;width:72px;height:72px;border-radius:9999px;background:rgba(255,255,255,0.92);color:#1A1A1A;font-size:22px;padding-left:4px;box-shadow:0 12px 32px rgba(0,0,0,.18)"
              >▶</span
            >
            <span class="vh">Ver el vídeo: cómo ponerse el alineador</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section
    data-sec
    id="tecnologia"
    data-peach
    aria-labelledby="tec-t"
    style={`background-color:#F8C7B6;background-image:url(${rosa.src});background-size:cover;background-position:center;padding:104px 0 128px;border-radius:40px`}
  >
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <h2
        data-h2-grande
        id="tec-t"
        style="margin:0 0 56px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:46px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:24ch"
      >
        Lo que hace que el plan se cumpla
      </h2>
      <div data-3col data-apretado style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px">
        {
          TECNOLOGIA.map((t) => (
            <article
              data-feat
              style="position:relative;overflow:hidden;min-height:288px;display:flex;flex-direction:column;justify-content:flex-end;background:#FFFFFF;border-radius:40px;padding:32px;box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06);cursor:pointer"
            >
              <img
                data-featimg
                src={t.imagen?.src ?? '/img/placeholder-liso-4x3.png'}
                alt=""
                aria-hidden="true"
                width={t.imagen?.width ?? 1024}
                height={t.imagen?.height ?? 768}
                loading="lazy"
                decoding="async"
                style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 300ms cubic-bezier(0.22,1,0.36,1)"
              />
              <span
                data-featveil
                aria-hidden="true"
                style="position:absolute;inset:0;background:rgba(0,0,0,0.82);opacity:0;transition:opacity 300ms cubic-bezier(0.22,1,0.36,1)"
              />
              {t.flotante && (
                <Image
                  data-featflot
                  src={t.flotante}
                  widths={[240, 480]}
                  sizes="(max-width:900px) 45vw, 180px"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <h3
                data-feattxt
                style="position:relative;margin:0 0 12px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:22px;letter-spacing:-0.02em;color:#000000"
              >
                {t.titulo}
              </h3>
              <p data-feattxt style="position:relative;margin:0 0 20px;font-size:16px;line-height:1.7;color:#6B6B6B">
                {t.texto}
              </p>
              <a
                data-feattxt
                data-underline
                href={t.video}
                data-video={incrustar(t.video)}
                data-titulo={t.titulo}
                style="position:relative;display:inline-flex;align-items:center;gap:8px;font-size:16px;font-weight:500;color:#1A1A1A"
              >
                Ver el vídeo <span>→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section data-sec id="primera-visita" aria-labelledby="pv-t" style="padding:112px 0 128px">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:64px;align-items:start">
        <div>
          <h2
            data-h2-grande
            id="pv-t"
            style="margin:0 0 40px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:46px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:20ch"
          >
            Tu primera visita es <span style="color:#E76B0B">GRATUITA</span>
          </h2>
          <ol style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:16px">
            {
              PRIMERA_VISITA.map((texto, i) => (
                <li style="display:flex;gap:20px;align-items:flex-start">
                  <span
                    aria-hidden="true"
                    style="flex:none;width:56px;height:56px;border-radius:20px;background:#E76B0B;color:#FFFFFF;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;display:flex;align-items:center;justify-content:center"
                  >
                    {i + 1}
                  </span>
                  <p style="margin:0;font-size:17px;line-height:1.7;color:#1A1A1A;max-width:60ch">{texto}</p>
                </li>
              ))
            }
          </ol>
        </div>
        <aside
          style={`background-color:#F7F7F7;background-image:url(${fondoPruebas.src});background-size:cover;background-position:center;border-radius:40px;padding:36px`}
        >
          <h3 style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:22px;letter-spacing:-0.02em;color:#000000">
            Pruebas incluidas
          </h3>
          <ul style="margin:0 0 28px;padding:0;list-style:none;display:flex;flex-direction:column;gap:14px">
            {
              PRUEBAS_INCLUIDAS.map((p) => (
                <li style="display:flex;gap:12px;font-size:16px;line-height:1.6;color:#1A1A1A">
                  <span
                    aria-hidden="true"
                    style="flex:none;width:20px;height:20px;border-radius:9999px;background:#E76B0B;color:#FFFFFF;font-size:12px;display:flex;align-items:center;justify-content:center;margin-top:3px"
                  >
                    ✓
                  </span>
                  {p}
                </li>
              ))
            }
          </ul>
          <a
            data-secondary
            href="/contacto/"
            style="display:inline-flex;white-space:nowrap;align-items:center;gap:10px;min-height:48px;padding:0 24px;border-radius:9999px;background:#FFFFFF;border:1px solid rgba(0,0,0,0.08);color:#1A1A1A;font-size:16px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),border-color 300ms cubic-bezier(0.22,1,0.36,1)"
            >Reserva tu visita<span>→</span></a
          >
        </aside>
      </div>
    </div>
  </section>

  <section data-sec data-solo-ancha id="faq" aria-labelledby="faq-t" style="background:#F7F7F7;padding:112px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:64px;align-items:start">
        <div>
          <h2
            data-h2-grande
            id="faq-t"
            style="margin:0;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:42px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:18ch"
          >
            Las dudas que más preguntan
          </h2>
        </div>
        <Acordeon client:visible filas={FAQ} />
      </div>
    </div>
  </section>

  <CtaFinal />

  <dialog data-dlg-video aria-label="Vídeo">
    <button type="button" data-dlg-cerrar aria-label="Cerrar el vídeo">✕</button>
    <div data-dlg-slot></div>
  </dialog>

  <script>
    // El <dialog> nativo ya trae Esc, el foco atrapado y el fondo oscurecido.
    // Sin JS, el enlace sigue llevando al vídeo en YouTube.
    const dlg = document.querySelector('dialog[data-dlg-video]') as HTMLDialogElement;
    const slot = dlg.querySelector('[data-dlg-slot]') as HTMLElement;

    document.querySelectorAll<HTMLElement>('[data-video]').forEach((el) => {
      el.addEventListener('click', (e) => {
        // En los enlaces, Cmd/Ctrl/Shift+clic siguen abriendo el vídeo en otra pestaña.
        if (el instanceof HTMLAnchorElement && (e.metaKey || e.ctrlKey || e.shiftKey)) return;
        e.preventDefault();
        const src = el.dataset.video as string;
        const titulo = el.dataset.titulo as string;
        // El vídeo propio va sin descarga, sin PiP y sin cambio de velocidad:
        // deja reproducir, pausar y el volumen. No impide guardar el archivo
        // desde la URL, solo quita los atajos de la interfaz.
        slot.innerHTML = src.endsWith('.mp4')
          ? `<video src="${src}" poster="/img/portada-alineador.webp" aria-label="${titulo}" controls autoplay playsinline controlsList="nodownload noplaybackrate noremoteplayback" disablePictureInPicture></video>`
          : `<iframe src="${src}" title="${titulo}" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>`;
        dlg.showModal();
      });
    });

    // El card entero abre el vídeo; el enlace de dentro sigue siendo el camino
    // por teclado y el fallback a YouTube sin JS.
    document.querySelectorAll<HTMLElement>('[data-feat]').forEach((card) => {
      const enlace = card.querySelector<HTMLElement>('[data-video]');
      if (!enlace) return;
      card.addEventListener('click', (e) => {
        if (!enlace.contains(e.target as Node)) enlace.click();
      });
    });

    slot.addEventListener('contextmenu', (e) => e.preventDefault());

    // Vaciar el hueco al cerrar: si no, el vídeo se queda sonando de fondo.
    dlg.addEventListener('close', () => (slot.innerHTML = ''));
    dlg.querySelector('[data-dlg-cerrar]')!.addEventListener('click', () => dlg.close());
    // Un clic en el backdrop tiene al propio dialog como target.
    dlg.addEventListener('click', (e) => e.target === dlg && dlg.close());
  </script>
</Base>
