---
import Base from '../../layouts/Base.astro';
import FormularioCita from '../../islands/FormularioCita';
import { CONTACTO, REDES_CONTACTO } from '../../data/site';

const ruta = '/contacto/';

const TARJETAS = [
  { etiqueta: 'Llámanos', valor: CONTACTO.telefono, href: `tel:${CONTACTO.telefonoE164}`, externo: false },
  { etiqueta: 'WhatsApp', valor: CONTACTO.whatsapp, href: CONTACTO.whatsappUrl, externo: false },
  { etiqueta: 'Email', valor: CONTACTO.email, href: `mailto:${CONTACTO.email}`, externo: false },
  {
    etiqueta: 'Dónde estamos',
    valor: `${CONTACTO.calle}, ${CONTACTO.cp} ${CONTACTO.ciudad}`,
    href: CONTACTO.mapsUrl,
    externo: true,
  },
];

---

<Base
  titulo="Sonris | Contacto"
  descripcion="Teléfono 910 459 517, WhatsApp 658 746 117, hola@sonris.es. Avenida Isabel de Valois 55, 28050 Madrid. Lunes a viernes de 12:00 a 20:00 h."
  {ruta}
  migas={[{ nombre: 'Contacto', href: ruta }]}
  headerVariante="solida"
  hrefCita="#formulario"
  conWhatsAppEnBarra
>
  <section data-sec id="datos" aria-labelledby="datos-t" style="padding:72px 0 96px">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:56px;align-items:start;margin-bottom:56px">
        <div>
        <h1
          data-h1
          id="datos-t"
          style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:700;font-size:52px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:20ch"
        >
          Hablamos cuando te venga bien
        </h1>
        <p style="margin:0 0 56px;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:56ch">
          Estamos en {CONTACTO.barrio}, de lunes a viernes de 12:00 a 20:00. Elige el canal que prefieras: todos llegan al mismo equipo.
        </p>
        </div>
        <!-- Los cuatro canales, dos por fila y sin icono: al lado del
             titular tienen que leerse de un vistazo, no competir con él. -->
        <ul style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 20px">
          {
            TARJETAS.map((c) => (
              <li>
                <span style="display:block;font-size:14px;color:#6B6B6B;margin-bottom:2px">{c.etiqueta}</span>
                <a
                  data-underline
                  href={c.href}
                  target={c.externo ? '_blank' : undefined}
                  rel={c.externo ? 'noopener noreferrer' : undefined}
                  style="position:relative;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:17px;letter-spacing:-0.02em;color:#000000"
                >
                  {c.valor}
                  {c.externo && <span class="vh"> (se abre en una pestaña nueva)</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div id="formulario" style="max-width:760px;margin:0 auto 64px">
        <FormularioCita
        client:load
        email={CONTACTO.email}
        telefono={CONTACTO.telefono}
        origen="la página de contacto"
        />
      </div>
      <div id="como-llegar">
            <h2
              data-h2-grande
              id="mapa-t"
              style="margin:0 0 28px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:40px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:20ch"
            >
              En Sanchinarro, junto a Isabel de Valois
            </h2>
            <div
              style="position:relative;aspect-ratio:16/10;border-radius:40px;overflow:hidden;background:#EFEFEF;box-shadow:0 12px 36px rgba(0,0,0,.03)"
            >
              <iframe
                title="Mapa de Sonris, Avenida Isabel de Valois 55, Madrid"
                data-src={CONTACTO.mapsEmbed}
                data-proveedor="Google Maps"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                style="position:absolute;inset:0;width:100%;height:100%;border:0;display:block"></iframe>
            </div>
            <p style="margin:16px 0 0;font-size:15px;color:#6B6B6B">
              <a
                data-underline
                href={CONTACTO.mapsUrl}
                style="position:relative;color:#1A1A1A;font-weight:500"
                target="_blank"
                rel="noopener noreferrer">Abre la ruta en Google Maps<span class="vh"> (se abre en una pestaña nueva)</span></a
              >
            </p>
      </div>
    </div>
  </section>

  <section data-sec data-peach data-textura aria-labelledby="redes-t" style="background-color:#FEE1CB;--velo:rgba(254,225,203,0.9);padding:104px 0 112px;border-radius:40px">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:56px;align-items:center">
        <div>
          <h2
            data-h2-grande
            id="redes-t"
            style="margin:0 0 16px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:40px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:18ch"
          >
            Aquí publicamos el día a día
          </h2>
          <p style="margin:0;font-size:18px;line-height:1.7;color:#1A1A1A;max-width:44ch">
            Casos, novedades y trozos de clínica. Si quieres ver cómo trabajamos antes de venir, empieza por Instagram.
          </p>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:16px">
          {
            REDES_CONTACTO.map((r) => (
              <a
                href={r.url}
                style="position:relative;display:inline-flex;align-items:center;min-height:56px;padding:0 26px;border-radius:9999px;background:#FFFFFF;font-size:17px;font-weight:600;color:#1A1A1A"
                target="_blank"
                rel="noopener noreferrer"
              >
                {r.nombre}
                <span class="vh"> (se abre en una pestaña nueva)</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>
