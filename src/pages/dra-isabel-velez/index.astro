---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import doctoraImg from '../../assets/sonris/equipo/Isabel-Velez-alineadores.jpg';
import bioImg from '../../assets/sonris/equipo/Isabel-Velez-alineador.jpg';
import libroImg from '../../assets/sonris/blog/libro-ortodoncia-con-alineadores-recorte.png';
import qrLibroImg from '../../assets/sonris/blog/qr-pre-orden-libro.png';
import confBruselas from '../../assets/sonris/conferencias/conferencia-eas7-bruselas.webp';
import confAuditorio from '../../assets/sonris/conferencias/auditorio-eas7-bruselas.webp';
import confTaller from '../../assets/sonris/conferencias/taller-con-doctores.webp';
import confSmartee from '../../assets/sonris/conferencias/ponencia-smartee.webp';
import confEscenario from '../../assets/sonris/conferencias/conferencia-sonris-escenario.webp';
import CtaFinal from '../../components/CtaFinal.astro';
import AntesDespues from '../../components/AntesDespues.astro';
import Cms from '../../components/Cms.astro';
import CmsImage from '../../components/CmsImage.astro';
import EnlaceContacto from '../../components/EnlaceContacto.astro';
import { c } from '../../lib/cms';
import { DIRECCION_MEDICA } from '../../data/site';

const ruta = '/dra-isabel-velez/';

const FORMACION = [
  ['Grado en Odontología', 'Universidad Popular Autónoma del Estado de Puebla, México.'],
  ['MSD Orthodontics and Dentofacial Orthopedics', 'Boston University, Estados Unidos.'],
  ['Especialidad en Ortodoncia y Ciencias Dentales', 'UNITEC, México.'],
  ['Homologación en España del título de Odontología', 'Ejercicio en España desde entonces.'],
  ['Lingual Orthodontics', 'Universidad de Ferrara, Italia.'],
  ['Directora de Radiodiagnóstico', 'Certificación vigente.'],
];

const MEMBRESIAS = ['SEDO', 'EAS', 'IASAO', 'CIRNO'];

const CONFERENCIAS = [
  [confBruselas, 'La Dra. Vélez ponente en el congreso EAS7 de Bruselas'],
  [confTaller, 'La Dra. Vélez explicando un caso a un grupo de doctores alrededor de una mesa'],
  [confAuditorio, 'Auditorio del congreso EAS7 de Bruselas durante su ponencia'],
  [confSmartee, 'La Dra. Vélez durante una ponencia sobre protocolos con alineadores'],
  [confEscenario, 'La Dra. Vélez en el escenario ante el público de una conferencia'],
] as const;
---

<Base
  titulo="Dra. Isabel Vélez, ortodoncista en Madrid | Sonris"
  descripcion="La Dra. Isabel Vélez, directora médica de Sonris, lleva más de 25 años dedicada en exclusiva a la ortodoncia invisible. Valoración en Sanchinarro, Madrid."
  {ruta}
  migas={[{ nombre: DIRECCION_MEDICA.nombre, href: ruta }]}
  tipoOg="profile"
  headerOscuro
  conDireccionMedicaEnFooter
>
  {/* Un solo fondo para toda la página (global.css, [data-fondo-pagina]):
      las secciones no llevan color propio, así no se leen como bloques. */}
  <div data-fondo-pagina aria-hidden="true"></div>

  <section
    id="inicio"
    aria-labelledby="hero-t"
    style="position:relative;overflow:hidden;padding:56px 0 112px"
  >
    <div style="position:relative;max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-hero data-invertir style="display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:64px;align-items:center">
        <figure style="margin:0">
          <div
            style="position:relative;aspect-ratio:4/5;border-radius:40px;overflow:hidden;background:repeating-linear-gradient(135deg,#F7F7F7 0 14px,#EFEFEF 14px 28px);box-shadow:0 4px 12px rgba(0,0,0,.06),0 24px 56px rgba(0,0,0,.10)"
          >
            <CmsImage
              k="dra.hero.foto"
              src={doctoraImg}
              widths={[500, 1000]}
              sizes="(max-width:900px) 100vw, 50vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              alt="Dra. Isabel Vélez, directora médica de Sonris"
              style="width:100%;height:100%;object-fit:cover;object-position:center 25%;display:block"
            />
            <div
              data-lamina
              data-lamina-xl
              style="position:absolute;left:24px;right:24px;bottom:0;padding:20px 24px;border-bottom-left-radius:0 !important;border-bottom-right-radius:0 !important;border-bottom:0"
            >
              <p
                style="margin:0 0 4px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:18px;line-height:1.3;letter-spacing:-0.02em;color:#000000"
              >
                <Cms k="dra.hero.lamina">Especialista en ortodoncia invisible</Cms>
              </p>
              <p style="margin:0 0 8px;font-size:15px;line-height:1.5;color:#1A1A1A">Nº de colegiado {DIRECCION_MEDICA.colegiado}</p>
            </div>
          </div>
        </figure>
        <div data-hero-texto>
          <h1
            data-h1
            id="hero-t"
            style="margin:0 0 24px;font-family:Poppins,system-ui,sans-serif;font-weight:700;font-size:64px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:16ch"
          >
            Dra. Isabel <span style="color:#000000">Vélez</span><a
              data-ig
              href="https://www.instagram.com/sonris.spain/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram de Sonris, @sonris.spain"
              style="display:inline-flex;vertical-align:baseline;margin-left:0.18em;color:#000000"
            >
              <!-- El icono se mide en em: sigue al h1 cuando encoge en móvil. -->
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" style="width:0.34em;height:0.34em;display:block">
                <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.06 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.35 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.06 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.35-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.06-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.35-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.06-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.35 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.56-.79.3-1.46.72-2.13 1.38S.93 3.35.63 4.14c-.3.76-.5 1.63-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13.67.67 1.34 1.08 2.13 1.38.76.3 1.63.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.56.79-.3 1.46-.71 2.13-1.38.67-.67 1.08-1.34 1.38-2.13.3-.76.5-1.63.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91-.3-.79-.71-1.46-1.38-2.13C21.32 1.35 20.65.93 19.86.63c-.76-.3-1.63-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z" />
              </svg>
              <span class="vh"> (se abre en una pestaña nueva)</span></a
            >
          </h1>
          <p style="margin:0 0 28px;font-size:19px;line-height:1.6;color:#1A1A1A;max-width:52ch">
            <Cms k="dra.hero.texto-1">Máxima categoría en ortodoncia invisible · más de 25 años dedicados en exclusiva a la ortodoncia.</Cms>
          </p>
          <p style="margin:0 0 36px;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:56ch">
            <Cms k="dra.hero.texto-2">Diagnostico y planifico tu plan de tratamiento, además formo a otros ortodoncistas en los casos que se salen de lo sencillo.</Cms>
          </p>
          <div data-botonera style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
            <a
              data-primary
              data-cta-largo
              href="/contacto/"
              style="display:inline-flex;flex:0 1 auto;max-width:100%;white-space:nowrap;align-items:center;gap:12px;min-height:56px;padding:0 32px;border-radius:9999px;background:#000000;color:#FFFFFF;font-size:18.66px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
              ><Cms k="dra.hero.boton">Reservar mi valoración</Cms><span data-arrow style="display:inline-block;transition:transform 300ms cubic-bezier(0.22,1,0.36,1)"
                >→</span
              ></a
            >
          </div>
          <p style="margin:20px 0 0;font-size:16px;color:#6B6B6B">
            <Cms k="dra.hero.llamada">Primera visita GRATUITA. O llámanos al</Cms>{' '}
            <EnlaceContacto tipo="telefono" data-underline style="color:#1A1A1A;font-weight:500" />.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section data-sec aria-labelledby="bio-t" style="padding:128px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:56px;align-items:center">
        <figure style="margin:0">
          <div
            style="aspect-ratio:4/5;border-radius:40px;overflow:hidden;background:repeating-linear-gradient(135deg,#F7F7F7 0 12px,#EFEFEF 12px 24px);box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06)"
          >
            <CmsImage
              k="dra.bio.foto"
              src={bioImg}
              widths={[420, 840]}
              sizes="(max-width:900px) 92vw, 420px"
              loading="lazy"
              decoding="async"
              alt="La Dra. Isabel Vélez en la clínica Sonris, tras un alineador transparente"
              style="width:100%;height:100%;object-fit:cover;display:block"
            />
          </div>
        </figure>
        <div>
          <h2
            data-h2-grande
            id="bio-t"
            style="margin:0 0 24px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:18ch"
          >
            <Cms k="dra.bio.titulo">Mi carrera entera en una sola especialidad</Cms>
          </h2>
          <p style="margin:0 0 20px;font-size:19px;line-height:1.7;color:#1A1A1A;max-width:65ch">
            <Cms k="dra.bio.texto-1">Soy licenciada en Odontología y especializada en ortodoncia, y llevo más de 25 años dedicada a la práctica exclusiva de la
            ortodoncia.</Cms>
          </p>
          <p style="margin:0 0 20px;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:65ch">
            <Cms k="dra.bio.texto-2">Tengo la máxima categoría de proveedor de ortodoncia invisible por la cantidad de casos terminados con éxito. Es un reconocimiento al volumen
            de tratamientos completados; cada caso se valora individualmente y ningún resultado clínico se puede garantizar por adelantado.</Cms>
          </p>
          <p style="margin:0;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:65ch">
            <Cms k="dra.bio.texto-3">Dirijo Sonris, en Sanchinarro, donde solo hacemos ortodoncia invisible.</Cms>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section data-sec aria-labelledby="form-t" style="padding:128px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:64px;align-items:start">
        <div>
          <h2
            data-h2-grande
            id="form-t"
            style="margin:0 0 24px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:40px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:18ch"
          >
            <Cms k="dra.formacion.titulo">De México a Boston, y de Italia a Madrid</Cms>
          </h2>
          <p style="margin:0;font-size:16px;line-height:1.7;color:#6B6B6B;max-width:40ch">
            Nº de colegiado {DIRECCION_MEDICA.colegiado}.
          </p>
        </div>
        <ol style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column">
          {
            FORMACION.map(([titulo, texto], i) => {
              const ultimo = i === FORMACION.length - 1;
              return (
                <li style="display:grid;grid-template-columns:auto 1fr;gap:24px">
                  <span aria-hidden="true" style="display:flex;flex-direction:column;align-items:center;gap:8px">
                    <span
                      style={`width:20px;height:20px;border-radius:9999px;border:2px solid #000000;background:${ultimo ? '#000000' : '#E4E4E4'};flex:none`}
                    />
                    {!ultimo && <span style="flex:1;width:2px;background:#D8D8D8" />}
                  </span>
                  <div style={ultimo ? '' : 'padding-bottom:32px'}>
                    <h3 style="margin:0 0 6px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;letter-spacing:-0.02em;color:#000000">
                      <Cms k={`dra.formacion.${i + 1}.titulo`}>{titulo}</Cms>
                    </h3>
                    <p style="margin:0;font-size:17px;line-height:1.7;color:#6B6B6B"><Cms k={`dra.formacion.${i + 1}.texto`}>{texto}</Cms></p>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </section>

  <section data-sec data-peach data-textura data-textura-ondas aria-labelledby="rec-t" style="background-color:#0A0A0A;--velo:rgba(10,10,10,0.78);padding:104px 0 128px;border-radius:40px">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:64px;align-items:start">
        <div>
          <h2
            data-h2-grande
            id="rec-t"
            style="margin:0 0 28px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:42px;line-height:1.1;letter-spacing:-0.02em;color:#FFFFFF;max-width:18ch"
          >
            <Cms k="dra.marcas.titulo">Certificada en las mejores marcas de alineadores</Cms>
          </h2>
          <div style="background:#FFFFFF;border-radius:40px;padding:32px;box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06)">
            <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px">
              <span
                style="display:inline-flex;align-items:center;gap:8px;background:#FFBC7D;color:#000000;border-radius:9999px;padding:8px 16px;font-size:11px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase"
                ><Cms k="comun.diamond">Diamond provider</Cms></span
              >
              <span
                style="display:inline-flex;align-items:center;gap:8px;background:#FFBC7D;color:#000000;border-radius:9999px;padding:8px 16px;font-size:11px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase"
                ><Cms k="dra.marcas.sello-2">Key Opinion Leader</Cms></span
              >
              <span
                style="display:inline-flex;align-items:center;gap:8px;background:#FFBC7D;color:#000000;border-radius:9999px;padding:8px 16px;font-size:11px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase"
                ><Cms k="dra.marcas.sello-3">Ortodoncia integral</Cms></span
              >
            </div>
            <p style="margin:0 0 12px;font-size:17px;line-height:1.7;color:#1A1A1A">
              <Cms k="dra.marcas.texto-1">Máxima categoría de proveedor de ortodoncia invisible, otorgada por el número de casos completados.</Cms>
            </p>
            <p style="margin:0;font-size:17px;line-height:1.7;color:#1A1A1A">
              <Cms k="dra.marcas.texto-2">Key opinion leader de Smartee y Dental Monitoring.</Cms>
            </p>
          </div>
        </div>
        <div>
          <h3 style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;letter-spacing:-0.02em;color:#FFFFFF">
            <Cms k="dra.marcas.exclusiva-titulo">Especialista en alineadores en exclusiva</Cms>
          </h3>
          <p style="margin:0 0 24px;font-size:17px;line-height:1.7;color:#E4E4E4;max-width:44ch">
            <Cms k="dra.marcas.exclusiva-texto">Trabaja únicamente con alineadores transparentes, y elige para cada caso el sistema que mejor se ajusta a lo que necesita esa
            boca.</Cms>
          </p>
          <h3 style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;letter-spacing:-0.02em;color:#FFFFFF">
            <Cms k="dra.membresias.titulo">Membresías</Cms>
          </h3>
          <div style="display:flex;flex-wrap:wrap;gap:12px">
            {
              MEMBRESIAS.map((m, i) => (
                <span style="display:inline-flex;align-items:center;height:56px;padding:0 22px;border-radius:12px;background:#FFFFFF;border:1px solid #E0E0E0;font-size:16px;font-weight:500;color:#1A1A1A">
                  <Cms k={`dra.membresias.${i + 1}`}>{m}</Cms>
                </span>
              ))
            }
          </div>        </div>
      </div>
    </div>
  </section>

  <section data-sec aria-labelledby="casos-t" style="padding:96px 0 128px">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      {/* Título y tarjeta lateral viven dentro de la isla: el selector de casos
          va junto al título y la tarjeta cuenta el caso visible, así que ambos
          necesitan el mismo estado que el comparador. */}
      <AntesDespues />
    </div>
  </section>

  <section data-sec aria-labelledby="doc-t" style="padding:112px 0 128px">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:64px;align-items:center">
        <div>
          <p
            style="margin:0 0 16px;font-size:12px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:#E76B0B"
          >
            <Cms k="dra.docencia.etiqueta">Key Opinion Leader en ortodoncia</Cms>
          </p>
          <h2
            data-h2-grande
            id="doc-t"
            style="margin:0 0 24px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
          >
            <Cms k="dra.docencia.titulo">Mi público no son solo pacientes: son doctores</Cms>
          </h2>
          <p style="margin:0 0 20px;font-size:18px;line-height:1.7;color:#1A1A1A;max-width:65ch">
            <Cms k="dra.docencia.texto-1">Imparto conferencias nacionales e internacionales a doctores de todo el mundo. Cuando otros ortodoncistas quieren aprender a
            llevar con alineadores los casos difíciles, me escuchan a mí.</Cms>
          </p>
          <p style="margin:0;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:65ch">
            <Cms k="dra.docencia.texto-2">Para ti eso significa una cosa práctica: el criterio con el que valoro tu caso es el mismo que enseño en esas salas.</Cms>
          </p>
        </div>
        {/* Muro de fotos en escritorio (columnas CSS, cada una con su
            proporción) y carrusel de una en una sólo en móvil: ver cinco a la
            vez en 360px no es verlas. El aspecto de cada modo, en el <style>
            del final. */}
        <div data-conf>
          <div data-conf-pista data-auto-carrusel="4500" aria-label="Conferencias de la Dra. Vélez">
            {
              CONFERENCIAS.map(([foto, descripcion], i) => (
                <figure>
                  <CmsImage
                    k={`dra.conferencias.${i + 1}`}
                    src={foto}
                    widths={[320, 640]}
                    sizes="(max-width:560px) 300px, 240px"
                    loading="lazy"
                    decoding="async"
                    alt={descripcion}
                    style="width:100%;height:auto;display:block"
                  />
                </figure>
              ))
            }
          </div>
          {
            [
              ['-1', 'Foto anterior', '‹', 'left:8px'],
              ['1', 'Foto siguiente', '›', 'right:8px'],
            ].map(([ir, etiqueta, glifo, lado]) => (
              <button
                type="button"
                data-ir={ir}
                aria-label={etiqueta}
                style={`position:absolute;top:50%;${lado};transform:translateY(-50%);align-items:center;justify-content:center;width:40px;height:40px;border-radius:9999px;background:rgba(255,255,255,0.92);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid rgba(0,0,0,0.08);font-size:20px;line-height:1;color:#1A1A1A;cursor:pointer`}
              >
                {glifo}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    data-sec
    data-peach
    data-textura
    data-textura-palitos
    id="libro"
    aria-labelledby="libro-t"
    style="background-color:#0A0A0A;--velo:rgba(10,10,10,0.78);padding:112px 0;border-radius:40px"
  >
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,6fr) minmax(0,6fr);gap:56px;align-items:center">
        <figure style="margin:0">
          {/* El libro entero lleva al mismo sitio que el botón. El QR va dentro del
              enlace para que pulsarlo no quede muerto; como código sigue siendo
              escaneable y conserva su fondo claro por contraste. */}
          <a
            data-libro
            href="https://jsj.top/f/OLppJ8"
            target="_blank"
            rel="noopener noreferrer"
