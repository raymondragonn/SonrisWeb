---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import doctoraImg from '../../assets/sonris/equipo/Isabel-Velez.webp';
import libroImg from '../../assets/sonris/blog/libro-ortodoncia-con-alineadores.png';
import qrLibroImg from '../../assets/sonris/blog/qr-pre-orden-libro.png';
import CtaFinal from '../../components/CtaFinal.astro';
import AntesDespues from '../../islands/AntesDespues';
import { CONTACTO, DIRECCION_MEDICA } from '../../data/site';

const ruta = '/dra-isabel-velez/';

const FORMACION = [
  ['Grado en Odontología', 'Universidad Popular Autónoma del Estado de Puebla, México.'],
  ['MSD Orthodontics and Dentofacial Orthopedics', 'Boston University, Estados Unidos.'],
  ['Especialidad en Ortodoncia y Ciencias Dentales', 'UNITEC, México.'],
  ['Homologación en España del título de Odontología', 'Ejercicio en España desde entonces.'],
  ['Lingual Orthodontics', 'Universidad de Ferrara, Italia.'],
  ['Directora de Radiodiagnóstico', 'Certificación vigente.'],
];

const MEMBRESIAS = ['SEDO', 'EAS', 'IASAO', 'CIRNO'];
---

<Base
  titulo="Sonris | Dra. Isabel Vélez"
  descripcion="La Dra. Isabel Vélez, directora médica de Sonris, lleva más de 25 años dedicada en exclusiva a la ortodoncia y tiene la máxima categoría de proveedor de ortodoncia invisible. Reserva tu valoración en Sanchinarro, Madrid."
  {ruta}
  migas={[{ nombre: DIRECCION_MEDICA.nombre, href: ruta }]}
  tipoOg="profile"
  conDireccionMedicaEnFooter
>
  <section
    id="inicio"
    aria-labelledby="hero-t"
    style="position:relative;overflow:hidden;background:linear-gradient(180deg,#FFFFFF 0%,rgba(254,225,203,0.5) 100%);padding:56px 0 112px"
  >
    <div
      aria-hidden="true"
      style="position:absolute;top:-180px;left:-160px;width:620px;height:500px;border-radius:9999px;background:#FEE1CB;filter:blur(80px);opacity:0.6;animation:sonris-float 22s ease-in-out infinite"
    >
    </div>
    <div
      aria-hidden="true"
      style="position:absolute;bottom:-220px;right:-140px;width:560px;height:460px;border-radius:9999px;background:#FFBC7D;filter:blur(90px);opacity:0.35;animation:sonris-float 28s ease-in-out infinite"
    >
    </div>
    <div style="position:relative;max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-hero style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:64px;align-items:center">
        <figure style="margin:0">
          <div
            style="position:relative;aspect-ratio:4/5;border-radius:40px;overflow:hidden;background:repeating-linear-gradient(135deg,#F7F7F7 0 14px,#EFEFEF 14px 28px);box-shadow:0 4px 12px rgba(0,0,0,.06),0 24px 56px rgba(0,0,0,.10)"
          >
            <Image
              src={doctoraImg}
              widths={[400, 669]}
              sizes="(max-width:900px) 100vw, 50vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              alt="Dra. Isabel Vélez, directora médica de Sonris"
              style="width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.28);transform-origin:center 30%"
            />
            <div
              data-lamina
              data-lamina-xl
              style="position:absolute;left:24px;right:24px;bottom:0;padding:20px 24px;border-bottom-left-radius:0 !important;border-bottom-right-radius:0 !important;border-bottom:0"
            >
              <p
                style="margin:0 0 4px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:18px;line-height:1.3;letter-spacing:-0.02em;color:#000000"
              >
                Especialista en ortodoncia invisible
              </p>
              <p style="margin:0 0 8px;font-size:15px;line-height:1.5;color:#1A1A1A">Nº de colegiado {DIRECCION_MEDICA.colegiado}</p>
            </div>
          </div>
        </figure>
        <div>
          <h1
            data-h1
            id="hero-t"
            style="margin:0 0 24px;font-family:Poppins,system-ui,sans-serif;font-weight:700;font-size:64px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:16ch"
          >
            Dra. Isabel <span style="color:#E76B0B">Vélez</span><a
              data-ig
              href="https://www.instagram.com/sonris.spain/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram de Sonris, @sonris.spain"
              style="display:inline-flex;vertical-align:baseline;margin-left:0.18em;color:#E76B0B"
            >
              <!-- El icono se mide en em: sigue al h1 cuando encoge en móvil. -->
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" style="width:0.34em;height:0.34em;display:block">
                <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.06 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.35 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.06 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.35-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.06-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.35-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.06-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.35 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.56-.79.3-1.46.72-2.13 1.38S.93 3.35.63 4.14c-.3.76-.5 1.63-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13.67.67 1.34 1.08 2.13 1.38.76.3 1.63.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.56.79-.3 1.46-.71 2.13-1.38.67-.67 1.08-1.34 1.38-2.13.3-.76.5-1.63.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91-.3-.79-.71-1.46-1.38-2.13C21.32 1.35 20.65.93 19.86.63c-.76-.3-1.63-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z" />
              </svg>
              <span class="vh"> (se abre en una pestaña nueva)</span></a
            >
          </h1>
          <p style="margin:0 0 28px;font-size:19px;line-height:1.6;color:#1A1A1A;max-width:52ch">
            Máxima categoría en ortodoncia invisible · más de 25 años dedicados en exclusiva a la ortodoncia.
          </p>
          <p style="margin:0 0 36px;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:56ch">
            Valoro tu caso, firmo tu plan de tratamiento y formo a otros ortodoncistas en los casos que se salen de lo sencillo.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
            <a
              data-primary
              data-cta-largo
              href="/contacto/#formulario"
              style="display:inline-flex;flex:0 1 auto;max-width:100%;white-space:nowrap;align-items:center;gap:12px;min-height:56px;padding:0 32px;border-radius:9999px;background:#E76B0B;color:#FFFFFF;font-size:18.66px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
              >Reserva tu valoración con la Dra. Vélez<span data-arrow style="display:inline-block;transition:transform 300ms cubic-bezier(0.22,1,0.36,1)"
                >→</span
              ></a
            >
          </div>
          <p style="margin:20px 0 0;font-size:16px;color:#6B6B6B">
            Primera visita gratuita. O llámanos al{' '}
            <a href={`tel:${CONTACTO.telefonoE164}`} data-underline style="color:#1A1A1A;font-weight:500">{CONTACTO.telefono}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section data-sec aria-labelledby="bio-t" style="padding:128px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:64px;align-items:start">
        <div>
          <h2
            data-h2-grande
            id="bio-t"
            style="margin:0;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:18ch"
          >
            Mi carrera entera en una sola especialidad
          </h2>
        </div>
        <div>
          <p style="margin:0 0 20px;font-size:19px;line-height:1.7;color:#1A1A1A;max-width:65ch">
            Soy licenciada en Odontología y especializada en ortodoncia, y llevo más de 25 años dedicada a la práctica exclusiva de la
            ortodoncia.
          </p>
          <p style="margin:0 0 20px;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:65ch">
            Tengo la máxima categoría de proveedor de ortodoncia invisible por la cantidad de casos terminados con éxito. Es un reconocimiento al volumen
            de tratamientos completados; cada caso se valora individualmente y ningún resultado clínico se puede garantizar por adelantado.
          </p>
          <p style="margin:0;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:65ch">
            Dirijo Sonris, en Sanchinarro, donde solo hacemos ortodoncia invisible.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section data-sec aria-labelledby="form-t" style="background:#F7F7F7;padding:128px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:64px;align-items:start">
        <div>
          <h2
            data-h2-grande
            id="form-t"
            style="margin:0 0 24px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:40px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:18ch"
          >
            De México a Boston, y de Italia a Madrid
          </h2>
          <p style="margin:0;font-size:16px;line-height:1.7;color:#6B6B6B;max-width:40ch">
            Nº de colegiado {DIRECCION_MEDICA.colegiado}.
          </p>
        </div>
        <ol style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column">
          {
            FORMACION.map(([titulo, texto], i) => {
              const ultimo = i === FORMACION.length - 1;
              return (
                <li style="display:grid;grid-template-columns:auto 1fr;gap:24px">
                  <span aria-hidden="true" style="display:flex;flex-direction:column;align-items:center;gap:8px">
                    <span
                      style={`width:20px;height:20px;border-radius:9999px;border:2px solid #E76B0B;background:${ultimo ? '#E76B0B' : '#FEE1CB'};flex:none`}
                    />
                    {!ultimo && <span style="flex:1;width:2px;background:#EDB992" />}
                  </span>
                  <div style={ultimo ? '' : 'padding-bottom:32px'}>
                    <h3 style="margin:0 0 6px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;letter-spacing:-0.02em;color:#000000">
                      {titulo}
                    </h3>
                    <p style="margin:0;font-size:17px;line-height:1.7;color:#6B6B6B">{texto}</p>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </section>

  <section data-sec data-peach data-textura aria-labelledby="rec-t" style="background-color:#FEE1CB;--velo:rgba(254,225,203,0.9);padding:104px 0 128px;border-radius:40px">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:64px;align-items:start">
        <div>
          <h2
            data-h2-grande
            id="rec-t"
            style="margin:0 0 28px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:42px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:18ch"
          >
            Diamond Provider y trabajo multimarca
          </h2>
          <div style="background:#FFFFFF;border-radius:40px;padding:32px;box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06)">
            <span
              style="display:inline-flex;align-items:center;gap:8px;background:#FFBC7D;color:#000000;border-radius:9999px;padding:8px 16px;font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;margin-bottom:16px"
              >◆ Diamond provider</span
            >
            <p style="margin:0 0 12px;font-size:17px;line-height:1.7;color:#1A1A1A">
              Máxima categoría de proveedor de ortodoncia invisible, otorgada por el número de casos completados.
            </p>
          </div>
        </div>
        <div>
          <h3 style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;letter-spacing:-0.02em;color:#000000">
            Especialista en alineadores en exclusiva
          </h3>
          <p style="margin:0 0 24px;font-size:17px;line-height:1.7;color:#1A1A1A;max-width:44ch">
            Trabaja únicamente con alineadores transparentes, y elige para cada caso el sistema que mejor se ajusta a lo que necesita esa
            boca.
          </p>
          <h3 style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;letter-spacing:-0.02em;color:#000000">
            Membresías
          </h3>
          <div style="display:flex;flex-wrap:wrap;gap:12px">
            {
              MEMBRESIAS.map((m) => (
                <span style="display:inline-flex;align-items:center;height:56px;padding:0 22px;border-radius:12px;background:#FFFFFF;border:1px solid #EDB992;font-size:16px;font-weight:500;color:#1A1A1A">
                  {m}
                </span>
              ))
            }
          </div>        </div>
      </div>
    </div>
  </section>

  <section data-sec aria-labelledby="doc-t" style="padding:112px 0 128px">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:64px;align-items:center">
        <div>
          <h2
            data-h2-grande
            id="doc-t"
            style="margin:0 0 24px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
          >
            Mi público no son solo pacientes: son doctores
          </h2>
          <p style="margin:0 0 20px;font-size:18px;line-height:1.7;color:#1A1A1A;max-width:65ch">
            Imparto conferencias nacionales e internacionales a doctores de todo el mundo. Cuando otros ortodoncistas quieren aprender a
            llevar con alineadores los casos difíciles, me escuchan a mí.
          </p>
          <p style="margin:0;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:65ch">
            Para ti eso significa una cosa práctica: el criterio con el que valoro tu caso es el mismo que enseño en esas salas.
          </p>
        </div>
        <figure style="margin:0">
          <div
            style="position:relative;aspect-ratio:4/3;border-radius:40px;overflow:hidden;background:repeating-linear-gradient(135deg,#F7F7F7 0 14px,#EFEFEF 14px 28px);box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06)"
          >
            <img
              src="/img/placeholder-liso-4x3.png"
              sizes="(max-width:900px) 100vw, 50vw"
              width="1024"
              height="768"
              loading="lazy"
              decoding="async"
              alt="La Dra. Isabel Vélez impartiendo una conferencia a otros ortodoncistas"
              style="width:100%;height:100%;object-fit:cover;display:block"
            />
          </div>
        </figure>
      </div>
    </div>
  </section>

  <section
    data-sec
    data-peach
    data-textura
    id="libro"
    aria-labelledby="libro-t"
    style="background-color:#FEE1CB;--velo:rgba(254,225,203,0.9);padding:112px 0;border-radius:40px"
  >
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-2col style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:64px;align-items:center">
        <figure style="margin:0">
          <div
            style="position:relative;border-radius:40px;overflow:hidden;background:#FFFFFF;padding:24px;box-shadow:0 4px 12px rgba(0,0,0,.06),0 24px 56px rgba(0,0,0,.10)"
          >
            <Image
              src={libroImg}
              widths={[520, 1040]}
              sizes="(max-width:900px) 100vw, 42vw"
              loading="lazy"
              decoding="async"
              alt="Portada y contraportada del libro Ortodoncia con alineadores, de la Dra. Isabel Vélez"
              style="width:100%;height:auto;display:block"
            />
            {/* El QR se apoya en la esquina, dentro del padding de la tarjeta: así
                nunca pisa el borde redondeado ni se recorta. */}
            <Image
              src={qrLibroImg}
              width={110}
              loading="lazy"
              decoding="async"
              alt="Código QR para pre-ordenar el libro"
              style="position:absolute;left:24px;bottom:24px;width:clamp(72px,14%,110px);height:auto;display:block;border-radius:12px;background:#FFFFFF;padding:8px;box-shadow:0 2px 8px rgba(0,0,0,.10)"
            />
          </div>
        </figure>
        <div>
          <h2
            data-h2-grande
            id="libro-t"
            style="margin:0 0 24px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:20ch"
          >
            He escrito el libro que me habría gustado tener
          </h2>
          <p style="margin:0 0 20px;font-size:18px;line-height:1.7;color:#1A1A1A;max-width:60ch">
            <em>Ortodoncia con alineadores</em> recoge más de veinticinco años de consulta en una guía práctica: biomecánica,
            protocolos clínicos y las soluciones S1 a S20, con códigos QR para ver la planificación digital de cada caso.
          </p>
          <p style="margin:0 0 28px;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:60ch">
            No es un manual teórico. Es lo que hago cada día, escrito para que otro ortodoncista pueda repetirlo, porque la
            predictibilidad no es casualidad: es biomecánica aplicada con criterio clínico.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:20px;align-items:center">
            <a
              data-primary
              href="https://jsj.top/f/OLppJ8"
              target="_blank"
              rel="noopener noreferrer"
              style="display:inline-flex;flex:none;white-space:nowrap;align-items:center;gap:12px;min-height:56px;padding:0 32px;border-radius:9999px;background:#E76B0B;color:#FFFFFF;font-size:18.66px;font-weight:600;transition:background 300ms var(--ease),box-shadow 300ms var(--ease)"
              >Pre-ordenar el libro<span data-arrow style="display:inline-block;transition:transform 300ms var(--ease)">→</span
              ><span class="vh"> (se abre en una pestaña nueva)</span></a
            >
            <p style="margin:0;font-size:15px;line-height:1.6;color:#6B6B6B;max-width:34ch">
              Con el Prof. Gang Shen y el Dr. Xingxing Wang. Editado por Smartee.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section data-sec aria-labelledby="casos-t" style="background:#F7F7F7;padding:128px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      {/* Título y tarjeta lateral viven dentro de la isla: el selector de casos
          va junto al título y la tarjeta cuenta el caso visible, así que ambos
          necesitan el mismo estado que el comparador. */}
      <AntesDespues client:visible />
    </div>
  </section>

  <CtaFinal />
</Base>
