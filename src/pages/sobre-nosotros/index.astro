---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { DIRECCION_MEDICA } from '../../data/site';
import isabel from '../../assets/sonris/equipo/Isabel-Velez.webp';
import hardy from '../../assets/sonris/equipo/Hardy-Luis-Giunta.png';
import antonio from '../../assets/sonris/equipo/Antoni-Salazar-Cabello.png';
import benjamin from '../../assets/sonris/equipo/Dr.-Benjamin-Cabrera-Galeano.png';
import recepcion from '../../assets/sonris/clinica/instalacion-recepcion.png';
import salaDeEspera from '../../assets/sonris/clinica/instalacion-sala-de-espera.png';
import zonaDeEscaneado from '../../assets/sonris/clinica/instalacion-zona-de-escaneado.png';
import consultorio from '../../assets/sonris/clinica/instalacion-consultorio.png';

const ruta = '/sobre-nosotros/';

const VALORES = [
  ['Tecnología digital', 'Aparatología de última generación que permite un diagnóstico más rápido, cómodo y efectivo.'],
  ['Trato cercano', 'Trato personalizado basado en la empatía, la cercanía y la confianza.'],
  ['Trayectoria profesional', 'Más de 25 años dedicados a la ortodoncia, con dirección médica propia desde el primer día.'],
];

const EQUIPO = [
  { area: 'Ortodoncia', nombre: 'Dr. Hardy Luis Giunta', rol: 'Especialista en ortodoncia', colegiado: '28013654', foto: hardy },
  { area: 'Atención al paciente', nombre: 'Johana Meza Ruival', rol: 'Atención al paciente y auxiliar', foto: null },
  { area: 'Higiene', nombre: 'Antonio Salazar Cabello', rol: 'Atención al paciente e higienista', foto: antonio },
  { area: 'Endodoncia y estética', nombre: 'Dr. Benjamín Cabrera Galeano', rol: 'Endodoncia y estética dental', foto: benjamin },
];

const INSTALACIONES = [
  ['Recepción', recepcion],
  ['Sala de espera', salaDeEspera],
  ['Zona de escaneado', zonaDeEscaneado],
  ['Consultorio', consultorio],
] as const;
const TOUR = 'https://my.matterport.com/show/?m=tmYDb9otn5k';
---

<Base
  titulo="Sonris | Sobre nosotros"
  descripcion="Más de 25 años dedicados en exclusiva a la ortodoncia invisible en Sanchinarro, Madrid. Conoce el equipo médico de Sonris y recorre la clínica en 3D."
  {ruta}
  migas={[{ nombre: 'Sobre nosotros', href: ruta }]}
>
  <section id="inicio" aria-labelledby="hero-t" style="position:relative;overflow:hidden;background:#000000">
    <div data-herobox style="position:relative;width:100%;aspect-ratio:16/9;max-height:88vh;overflow:hidden">
      <img
        src="/img/placeholder-liso-16x9.png"
        alt="Recorrido por el centro Sonris en Sanchinarro"
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block"
      />
      <div
        aria-hidden="true"
        style="position:absolute;inset:0;background:rgba(0,0,0,0.62);background-image:linear-gradient(180deg,rgba(0,0,0,0.1) 0%,rgba(0,0,0,0.25) 55%,rgba(0,0,0,0.55) 100%)"
      >
      </div>
      <div
        data-herotexto
        style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:0 40px 96px"
      >
        <div style="max-width:1240px;width:100%;margin:0 auto">
          <h1
            data-h1
            id="hero-t"
            style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:700;font-size:68px;line-height:1.05;letter-spacing:-0.02em;color:#FFFFFF;max-width:14ch"
          >
            Un centro que solo hace <span style="color:#EB6B0A">esto</span>
          </h1>
          <p style="margin:0 0 28px;font-size:19px;line-height:1.6;color:rgba(255,255,255,0.88);max-width:44ch">
            Más de 25 años dedicados en exclusiva a la ortodoncia invisible, en Sanchinarro.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
            <a
              data-primary
              href="/contacto/#formulario"
              style="display:inline-flex;flex:none;white-space:nowrap;align-items:center;gap:12px;min-height:56px;padding:0 32px;border-radius:9999px;background:#B24E00;color:#FFFFFF;font-size:17px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
              >Ven a conocernos<span data-arrow style="display:inline-block;transition:transform 300ms cubic-bezier(0.22,1,0.36,1)">→</span></a
            >
            <a
              href="#instalaciones"
              style="display:inline-flex;flex:none;white-space:nowrap;align-items:center;min-height:56px;padding:0 28px;border-radius:9999px;background:rgba(0,0,0,0.55);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.7);color:#FFFFFF;font-size:17px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1)"
              >Ver las instalaciones</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <section data-sec aria-label="Cómo trabajamos" style="padding:112px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div data-3col style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px">
        {
          VALORES.map(([titulo, texto]) => (
            <article
              data-feat
              style="position:relative;overflow:hidden;min-height:264px;display:flex;flex-direction:column;justify-content:flex-end;background:#FFFFFF;border-radius:40px;padding:36px;box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06)"
            >
              <img
                data-featimg
                src="/img/placeholder-liso-4x3.png"
                alt=""
                aria-hidden="true"
                width="1024"
                height="768"
                loading="lazy"
                decoding="async"
                style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 300ms cubic-bezier(0.22,1,0.36,1)"
              />
              <span
                data-featveil
                aria-hidden="true"
                style="position:absolute;inset:0;background:rgba(0,0,0,0.82);opacity:0;transition:opacity 300ms cubic-bezier(0.22,1,0.36,1)"
              />
              <h2
                data-feattxt
                style="position:relative;margin:0 0 12px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:22px;line-height:1.3;letter-spacing:-0.02em;color:#000000"
              >
                {titulo}
              </h2>
              <p data-feattxt style="position:relative;margin:0;font-size:16px;line-height:1.7;color:#6B6B6B">
                {texto}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section data-sec data-band-gray id="equipo" aria-labelledby="eq-t" style="background:#F7F7F7;padding:128px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div style="display:flex;flex-wrap:wrap;gap:24px;align-items:flex-end;justify-content:space-between;margin-bottom:56px">
        <h2
          data-h2-grande
          id="eq-t"
          style="margin:0;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
        >
          Las personas que vas a ver cada vez que vengas
        </h2>
      </div>

      <article
        data-member
        style="background:#FFFFFF;border-radius:40px;padding:32px;box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06);transition:transform 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1);margin-bottom:32px"
      >
        <div data-2col style="display:grid;grid-template-columns:200px minmax(0,1fr);gap:32px;align-items:center">
          <div
            style="border-radius:40px;overflow:hidden;aspect-ratio:4/5;background:repeating-linear-gradient(135deg,#F7F7F7 0 12px,#EFEFEF 12px 24px)"
          >
            <Image
              data-portrait
              src={isabel}
              widths={[340, 669]}
              sizes="(max-width:900px) 170vw, 340px"
              loading="lazy"
              decoding="async"
              alt="Dra. Isabel Vélez, directora médica de Sonris"
              style="width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.7);transform-origin:62% 28%"
            />
          </div>
          <div>
            <span
              style="display:inline-flex;align-items:center;background:#FEE1CB;color:#1A1A1A;border-radius:9999px;padding:6px 14px;font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;margin-bottom:16px"
              >Dirección médica</span
            >
            <h3 style="margin:0 0 8px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:28px;letter-spacing:-0.02em;color:#000000">
              {DIRECCION_MEDICA.nombre}
            </h3>
            <p style="margin:0 0 20px;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:60ch">
              Directora médica · Máxima categoría en ortodoncia invisible · más de 25 años dedicados en exclusiva a la ortodoncia.
            </p>
            <a
              data-underline
              href="/dra-isabel-velez/"
              style="display:inline-flex;align-items:center;gap:10px;font-size:17px;font-weight:500;color:#1A1A1A"
              >Ver su página completa <span>→</span></a
            >
          </div>
        </div>
      </article>

      <div data-4col style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px">
        {
          EQUIPO.map((m) => (
            <article
              data-member
              style="background:#FFFFFF;border-radius:40px;padding:28px;box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06);transition:transform 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
            >
              <div style="border-radius:40px;overflow:hidden;aspect-ratio:4/5;background:repeating-linear-gradient(135deg,#F7F7F7 0 12px,#EFEFEF 12px 24px);margin-bottom:20px;position:relative">
                {m.foto && (
                <Image
                  data-portrait
                  data-circulo
                  src={m.foto}
                  widths={[352, 704]}
                  sizes="(max-width:900px) 100vw, 25vw"
                  loading="lazy"
                  decoding="async"
                  alt={`${m.nombre}, ${m.rol.toLowerCase()} en Sonris`}
                  style="width:100%;height:100%;object-fit:cover;display:block"
                />
                )}
              </div>
              <span style="display:inline-flex;align-items:center;background:#FEE1CB;color:#1A1A1A;border-radius:9999px;padding:6px 12px;font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;margin-bottom:14px">
                {m.area}
              </span>
              <h3 style="margin:0 0 6px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;line-height:1.3;letter-spacing:-0.02em;color:#000000">
                {m.nombre}
              </h3>
              <p style="margin:0 0 6px;font-size:16px;line-height:1.6;color:#6B6B6B">{m.rol}</p>
              {m.colegiado && <p style="margin:0 0 18px;font-size:15px;color:#6B6B6B">Nº col. {m.colegiado}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section data-sec id="instalaciones" aria-labelledby="inst-t" style="padding:128px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div style="display:flex;flex-wrap:wrap;gap:24px;align-items:flex-end;justify-content:space-between;margin-bottom:48px">
        <h2
          data-h2-grande
          id="inst-t"
          style="margin:0;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
        >
          Mira la clínica antes de venir
        </h2>
      </div>
      <div data-gal style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-bottom:48px">
        {
          INSTALACIONES.map(([nombre, foto]) => (
            <figure style="margin:0">
              <div style="aspect-ratio:1/1;border-radius:40px;overflow:hidden;background:repeating-linear-gradient(135deg,#F7F7F7 0 12px,#EFEFEF 12px 24px)">
                <Image
                  src={foto}
                  widths={[480, 800, 1200]}
                  sizes="(max-width:900px) 100vw, 25vw"
                  loading="lazy"
                  decoding="async"
                  alt={`${nombre} de la clínica Sonris en Sanchinarro`}
                  style="width:100%;height:100%;object-fit:cover;display:block"
                />
              </div>
              <figcaption style="margin:12px 0 0;font-size:15px;color:#6B6B6B">{nombre}</figcaption>
            </figure>
          ))
        }
      </div>

      <div
        style="position:relative;aspect-ratio:16/9;border-radius:40px;overflow:hidden;background:#EFEFEF;box-shadow:0 12px 36px rgba(0,0,0,.03)"
      >
        <iframe
          title="Tour virtual en 3D del centro Sonris"
          data-src={TOUR}
          data-proveedor="Matterport"
          loading="lazy"
          allowfullscreen
          allow="xr-spatial-tracking"
          style="position:absolute;inset:0;width:100%;height:100%;border:0;display:block"></iframe>
      </div>
      <p style="margin:16px 0 0;font-size:15px;color:#6B6B6B">
        <a data-underline href={TOUR} style="position:relative;color:#1A1A1A;font-weight:500" target="_blank" rel="noopener noreferrer"
          >Abrir el tour en una pestaña nueva<span class="vh"> (se abre en una pestaña nueva)</span></a
        >
      </p>
    </div>
  </section>

  <CtaFinal titulo="Cuéntanos qué te preocupa" />
</Base>
