---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { DIRECCION_MEDICA } from '../../data/site';
import isabel from '../../assets/sonris/equipo/Isabel-Velez-recepcion.jpg';
import heroFachada from '../../assets/sonris/clinica/fachada-equipo.jpg';
import heroCajas from '../../assets/sonris/clinica/equipo-cajas-alineadores.jpg';
import heroAlineador from '../../assets/sonris/clinica/equipo-alineador-gigante.jpg';
import hardy from '../../assets/sonris/equipo/Hardy-Luis-Giunta.png';
import antonio from '../../assets/sonris/equipo/Antoni-Salazar-Cabello.png';
import benjamin from '../../assets/sonris/equipo/Dr.-Benjamin-Cabrera-Galeano.png';
import johana from '../../assets/sonris/equipo/Johana-Meza-Ruibal.jpg';
import recepcion from '../../assets/sonris/clinica/instalacion-recepcion.png';
import salaDeEspera from '../../assets/sonris/clinica/instalacion-sala-de-espera.png';
import zonaDeEscaneado from '../../assets/sonris/clinica/instalacion-zona-de-escaneado.png';
import consultorio from '../../assets/sonris/clinica/instalacion-consultorio.png';
import fondoEquipo from '../../assets/sonris/iconos/fondo-memphis-tratamientos.png';

const ruta = '/sobre-nosotros/';

/** Fondo del hero: las tres fotos del equipo, con el encuadre de cada una. */
const HERO_FOTOS = [
  [heroFachada, 'La fachada de la clínica Sonris en Sanchinarro con el equipo en la puerta', 'center 62%'],
  [heroCajas, 'El equipo de Sonris con las cajas de alineadores infantiles', 'center 30%'],
  [heroAlineador, 'El equipo de Sonris sosteniendo un alineador gigante', 'center 28%'],
] as const;
const CICLO_HERO = 15; // segundos: 5 por foto

const EQUIPO = [
  { area: 'Ortodoncia', nombre: 'Dr. Hardy Luis Giunta', rol: 'Especialista en ortodoncia', colegiado: '28013654', foto: hardy, circulo: true },
  { area: 'Atención al paciente', nombre: 'Johana Meza Ruibal', rol: 'Atención al paciente y auxiliar', foto: johana, circulo: false },
  { area: 'Higiene', nombre: 'Antonio Salazar Cabello', rol: 'Atención al paciente e higienista', foto: antonio, circulo: true },
  { area: 'Endodoncia y estética', nombre: 'Dr. Benjamín Cabrera Galeano', rol: 'Endodoncia y estética dental', foto: benjamin, circulo: true },
];

const INSTALACIONES = [
  ['Recepción', recepcion],
  ['Sala de espera', salaDeEspera],
  ['Zona de escaneado', zonaDeEscaneado],
  ['Consultorio', consultorio],
] as const;
const TOUR = 'https://my.matterport.com/show/?m=tmYDb9otn5k';

const fondo = await getImage({ src: fondoEquipo, width: 1672, format: 'webp' });
---

<Base
  titulo="Sonris | Sobre nosotros"
  descripcion="Más de 25 años dedicados en exclusiva a la ortodoncia invisible en Sanchinarro, Madrid. Conoce el equipo médico de Sonris y recorre la clínica en 3D."
  {ruta}
  migas={[{ nombre: 'Sobre nosotros', href: ruta }]}
>
  <section id="inicio" aria-labelledby="hero-t" style="position:relative;overflow:hidden;background:#000000">
    {/* Las tres fotos del equipo se relevan con fundido, sin JS: cada capa se
        ve un tercio del ciclo y los retardos negativos las arrancan ya
        desfasadas. Mismo recurso que el flotante de WhatsApp. */}
    <div data-herobox data-hero-corto style="position:relative;width:100%;aspect-ratio:21/9;max-height:68vh;overflow:hidden">
      {
        HERO_FOTOS.map(([foto, descripcion, encuadre], i) => (
          <Image
            data-relevo
            src={foto}
            widths={[900, 1600, 2200]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            alt={i === 0 ? String(descripcion) : ''}
            style={`position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:${encuadre};display:block;animation-delay:${-i * (CICLO_HERO / HERO_FOTOS.length)}s`}
          />
        ))
      }
      <div
        aria-hidden="true"
        style="position:absolute;inset:0;background-image:linear-gradient(180deg,rgba(0,0,0,0.28) 0%,rgba(0,0,0,0.45) 55%,rgba(0,0,0,0.72) 100%)"
      >
      </div>
      <div
        data-herotexto
        style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:0 40px 72px"
      >
        <div style="max-width:1240px;width:100%;margin:0 auto">
          <h1
            data-h1
            style="margin:0 0 20px;font-family:Poppins,system-ui,sans-serif;font-weight:700;font-size:60px;line-height:1.1;letter-spacing:-0.02em;color:#FFFFFF;max-width:20ch"
          >
            Un centro que solo hace <span style="color:#FFBC7D">esto</span>
          </h1>
          <p id="hero-t" style="margin:0 0 32px;font-size:18px;line-height:1.7;color:#E4E4E4;max-width:60ch">
            Más de 25 años dedicados en exclusiva a la ortodoncia invisible, en Sanchinarro.
          </p>
          <div data-botonera style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
            <a
              data-primary
              href="/contacto/"
              style="display:inline-flex;flex:none;white-space:nowrap;align-items:center;min-height:56px;padding:0 30px;border-radius:9999px;background:#E76B0B;color:#FFFFFF;font-size:18.66px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
              >Ven a conocernos</a
            >
            <a
              data-secondary
              href="#instalaciones"
              style="display:inline-flex;flex:none;white-space:nowrap;align-items:center;min-height:56px;padding:0 26px;border-radius:9999px;background:#FFFFFF;border:1px solid rgba(0,0,0,0.08);color:#1A1A1A;font-size:16px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),border-color 300ms cubic-bezier(0.22,1,0.36,1)"
              >Ver las instalaciones</a
            >
            <a
              data-secondary
              href="#equipo"
              style="display:inline-flex;flex:none;white-space:nowrap;align-items:center;min-height:56px;padding:0 26px;border-radius:9999px;background:#FFFFFF;border:1px solid rgba(0,0,0,0.08);color:#1A1A1A;font-size:16px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),border-color 300ms cubic-bezier(0.22,1,0.36,1)"
              >Conoce al equipo</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <section data-sec id="instalaciones" aria-labelledby="inst-t" style="padding:128px 0">
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div style="display:flex;flex-wrap:wrap;gap:24px;align-items:flex-end;justify-content:space-between;margin-bottom:48px">
        <h2
          data-h2-grande
          id="inst-t"
          style="margin:0;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
        >
          Mira la clínica antes de venir
        </h2>
      </div>
      <div
        style="position:relative;aspect-ratio:16/9;border-radius:40px;overflow:hidden;background:#EFEFEF;box-shadow:0 12px 36px rgba(0,0,0,.03)"
      >
        <iframe
          title="Tour virtual en 3D del centro Sonris"
          data-src={TOUR}
          data-proveedor="Matterport"
          loading="lazy"
          allowfullscreen
          allow="xr-spatial-tracking"
          style="position:absolute;inset:0;width:100%;height:100%;border:0;display:block"></iframe>
      </div>
      <p style="margin:16px 0 0;font-size:15px;color:#6B6B6B">
        <a data-underline href={TOUR} style="position:relative;color:#1A1A1A;font-weight:500" target="_blank" rel="noopener noreferrer"
          >Abrir el tour en una pestaña nueva<span class="vh"> (se abre en una pestaña nueva)</span></a
        >
      </p>

      <div data-gal style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:40px">
        {
          INSTALACIONES.map(([nombre, foto]) => (
            <figure style="margin:0">
              <div style="aspect-ratio:1/1;border-radius:40px;overflow:hidden;background:repeating-linear-gradient(135deg,#F7F7F7 0 12px,#EFEFEF 12px 24px)">
                <Image
                  src={foto}
                  widths={[480, 800, 1200]}
                  sizes="(max-width:560px) 45vw, (max-width:900px) 100vw, 25vw"
                  loading="lazy"
                  decoding="async"
                  alt={`${nombre} de la clínica Sonris en Sanchinarro`}
                  style="width:100%;height:100%;object-fit:cover;display:block"
                />
              </div>
              <figcaption style="margin:12px 0 0;font-size:15px;color:#6B6B6B">{nombre}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section
    data-sec
    id="equipo"
    aria-labelledby="eq-t"
    style={`background-color:#CCE1E4;background-image:url(${fondo.src});background-size:cover;background-position:center;padding:128px 0`}
  >
    <div style="max-width:1240px;margin:0 auto;padding:0 40px">
      <div style="display:flex;flex-wrap:wrap;gap:24px;align-items:flex-end;justify-content:space-between;margin-bottom:56px">
        <h2
          data-h2-grande
          id="eq-t"
          style="margin:0;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:44px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
        >
          Las personas que vas a ver cada vez que vengas
        </h2>
      </div>

      <article
        data-member
        style="background:#FFFFFF;border-radius:40px;padding:32px;box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06);transition:transform 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1);margin-bottom:32px"
      >
        <div data-eq-lider style="display:grid;grid-template-columns:200px minmax(0,1fr);gap:32px;align-items:center">
          <div
            style="border-radius:40px;overflow:hidden;aspect-ratio:4/5;background:repeating-linear-gradient(135deg,#F7F7F7 0 12px,#EFEFEF 12px 24px)"
          >
            <Image
              data-portrait
              src={isabel}
              widths={[220, 440, 669]}
              sizes="(max-width:560px) 108px, (max-width:900px) 200px, 340px"
              loading="lazy"
              decoding="async"
              data-acerca
              alt="Dra. Isabel Vélez, directora médica de Sonris"
              style="width:100%;height:100%;object-fit:cover;object-position:center 18%;display:block"
            />
          </div>
          <div>
            <span
              style="display:inline-flex;align-items:center;background:#FEE1CB;color:#1A1A1A;border-radius:9999px;padding:6px 14px;font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;margin-bottom:16px"
              >Dirección médica</span
            >
            <h3 style="margin:0 0 8px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:28px;letter-spacing:-0.02em;color:#000000">
              {DIRECCION_MEDICA.nombre}
            </h3>
            <p style="margin:0 0 20px;font-size:18px;line-height:1.7;color:#6B6B6B;max-width:60ch">
              Directora médica · Máxima categoría en ortodoncia invisible · más de 25 años dedicados en exclusiva a la ortodoncia.
            </p>
            <a
              data-underline
              href="/dra-isabel-velez/"
              style="display:inline-flex;align-items:center;gap:10px;font-size:17px;font-weight:500;color:#1A1A1A"
              >Ver su página completa <span>→</span></a
            >
          </div>
        </div>
      </article>

      <div data-4col style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px">
        {
          EQUIPO.map((m) => (
            <article
              data-member
              style="background:#FFFFFF;border-radius:40px;padding:28px;box-shadow:0 2px 8px rgba(0,0,0,.04),0 12px 32px rgba(0,0,0,.06);transition:transform 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
            >
              <div style="border-radius:40px;overflow:hidden;aspect-ratio:4/5;background:repeating-linear-gradient(135deg,#F7F7F7 0 12px,#EFEFEF 12px 24px);margin-bottom:20px;position:relative">
                {m.foto && (
                <Image
                  data-portrait
                  data-circulo={m.circulo ? true : undefined}
                  src={m.foto}
                  widths={[352, 704]}
                  sizes="(max-width:900px) 45vw, 25vw"
                  loading="lazy"
                  decoding="async"
                  alt={`${m.nombre}, ${m.rol.toLowerCase()} en Sonris`}
                  style="width:100%;height:100%;object-fit:cover;object-position:center 22%;display:block"
                />
                )}
              </div>
              <span style="display:inline-flex;align-items:center;background:#FEE1CB;color:#1A1A1A;border-radius:9999px;padding:6px 12px;font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;margin-bottom:14px">
                {m.area}
              </span>
              <h3 style="margin:0 0 6px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:20px;line-height:1.3;letter-spacing:-0.02em;color:#000000">
                {m.nombre}
              </h3>
              <p style="margin:0 0 6px;font-size:16px;line-height:1.6;color:#6B6B6B">{m.rol}</p>
              {m.colegiado && <p style="margin:0 0 18px;font-size:15px;color:#6B6B6B">Nº col. {m.colegiado}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaFinal />
</Base>

<style define:vars={{ ciclo: `${CICLO_HERO}s` }}>
  /* Cada foto se ve un tercio del ciclo y se funde con la siguiente. */
  [data-relevo] {
    opacity: 0;
    animation: relevo-hero var(--ciclo) linear infinite;
  }
  @keyframes relevo-hero {
    0%,
    28% {
      opacity: 1;
    }
    33%,
    95% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  /* Quien pide menos movimiento se queda con una sola foto, no con un hero
     parpadeando detrás del titular. */
  @media (prefers-reduced-motion: reduce) {
    [data-relevo] {
      animation: none;
    }
    [data-relevo]:first-of-type {
      opacity: 1;
    }
  }
</style>
