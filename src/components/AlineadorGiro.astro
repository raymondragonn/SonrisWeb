---
// Seis poses de una vuelta del alineador, apiladas. El giro lo conduce ui.ts:
// la X del puntero dentro del elemento [data-alineador] que envuelva a este
// componente elige la pose y funde cada una con la siguiente. Solo la primera
// trae src; las otras cinco esperan en data-src y no se piden en táctil.
const GIRO = [1, 2, 3, 4, 5, 6];
const { alt, estilo = '', prioridad = false } = Astro.props as { alt: string; estilo?: string; prioridad?: boolean };
---

<div
  data-giro
  style={`position:absolute;transform:perspective(1100px) rotateY(var(--giro,0deg)) rotateX(var(--vuelco,0deg));will-change:transform;${estilo}`}
>
  {
    GIRO.map((n) => (
      <img
        src={n === 1 ? '/img/alineador/alineador-1.webp' : undefined}
        data-src={`/img/alineador/alineador-${n}.webp`}
        width="900"
        height="558"
        loading={n === 1 && prioridad ? 'eager' : 'lazy'}
        fetchpriority={n === 1 && prioridad ? 'high' : undefined}
        decoding="async"
        alt={n === 1 ? alt : ''}
        aria-hidden={n === 1 ? undefined : 'true'}
        style={`position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block;opacity:${n === 1 ? 1 : 0}`}
      />
    ))
  }
</div>
