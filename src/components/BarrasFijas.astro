---
import { CONTACTO } from '../data/site';
import textura1 from '../assets/sonris/texturas/textura-1.webp';
import textura2 from '../assets/sonris/texturas/textura-2.webp';
import textura3 from '../assets/sonris/texturas/textura-3.webp';
import textura4 from '../assets/sonris/texturas/textura-4.webp';

// Fondo del flotante: las cuatro texturas se van relevando con fundido. Están
// recortadas al cuadrado y servidas a 112px (el doble del botón), así que las
// cuatro juntas pesan menos que un icono suelto.
const TEXTURAS = [textura1, textura2, textura3, textura4];
const CICLO = 16; // segundos: 4 por textura

interface Props {
  hrefCita?: string;
}
const { hrefCita = '/contacto/' } = Astro.props;

/** Glifo de WhatsApp (burbuja + auricular), trazado único para pintar con currentColor. */
const WHATSAPP_PATH =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z';
---

<a
  data-wa
  data-primary
  href={CONTACTO.whatsappUrl}
  aria-label={`Escríbenos por WhatsApp al ${CONTACTO.whatsapp}`}
  style="position:fixed;right:28px;bottom:28px;z-index:80;display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:9999px;overflow:hidden;background:#D1E3E6;color:#16163F;box-shadow:0 4px 12px rgba(0,0,0,.06),0 24px 56px rgba(0,0,0,.10);transition:box-shadow 300ms cubic-bezier(0.22,1,0.36,1),transform 300ms cubic-bezier(0.22,1,0.36,1)"
>
  {
    TEXTURAS.map((t, i) => (
      <span
        data-textura
        aria-hidden="true"
        style={`position:absolute;inset:0;background-image:url(${t.src});background-size:cover;animation-delay:${-i * (CICLO / TEXTURAS.length)}s`}
      />
    ))
  }
  <svg
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
    style="position:relative"
  >
    <path d={WHATSAPP_PATH} />
  </svg>
</a>

<style define:vars={{ ciclo: `${CICLO}s` }}>
  /* Cada capa se muestra un cuarto del ciclo y se funde con la siguiente. Los
     retardos negativos del marcado las arrancan ya desfasadas, así que no hay
     un primer pase en el que se vean todas a la vez. */
  [data-textura] {
    opacity: 0;
    animation: relevo var(--ciclo) linear infinite;
  }
  @keyframes relevo {
    0%,
    20% {
      opacity: 1;
    }
    25%,
    95% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  /* Quien pide menos movimiento se queda con una textura fija, no con un botón
     parpadeando en la esquina. */
  @media (prefers-reduced-motion: reduce) {
    [data-textura] {
      animation: none;
    }
    [data-textura]:first-of-type {
      opacity: 1;
    }
  }
</style>

<div
  data-mobilebar
  style="position:fixed;left:0;right:0;bottom:0;z-index:80;background:rgba(255,255,255,0.94);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-top:1px solid rgba(0,0,0,0.08);padding:12px 16px;gap:12px;align-items:center"
>
  <a
    data-primary
    href={hrefCita}
    style="flex:1;display:inline-flex;align-items:center;justify-content:center;min-height:56px;border-radius:9999px;background:#E76B0B;color:#FFFFFF;font-size:17px;font-weight:600;letter-spacing:-0.01em"
    >Reserva tu visita gratuita</a
  >
  <a
    href={CONTACTO.whatsappUrl}
    aria-label={`Escríbenos por WhatsApp al ${CONTACTO.whatsapp}`}
    style="position:relative;width:56px;height:56px;flex:none;border-radius:9999px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:#D1E3E6;color:#16163F"
  >
    {
      TEXTURAS.map((t, i) => (
        <span
          data-textura
          aria-hidden="true"
          style={`position:absolute;inset:0;background-image:url(${t.src});background-size:cover;animation-delay:${-i * (CICLO / TEXTURAS.length)}s`}
        />
      ))
    }
    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" style="position:relative">
      <path d={WHATSAPP_PATH} />
    </svg>
  </a>
</div>
