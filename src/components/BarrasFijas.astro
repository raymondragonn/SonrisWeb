---
import { CONTACTO } from '../data/site';

interface Props {
  hrefCita?: string;
  /** La barra móvil de contacto lleva además el atajo a WhatsApp. */
  conWhatsAppEnBarra?: boolean;
}
const { hrefCita = '/contacto/#formulario', conWhatsAppEnBarra = false } = Astro.props;
---

<a
  data-wa
  data-primary
  href={CONTACTO.whatsappUrl}
  aria-label={`Escríbenos por WhatsApp al ${CONTACTO.whatsapp}`}
  style="position:fixed;right:28px;bottom:28px;z-index:80;display:inline-flex;align-items:center;gap:10px;min-height:56px;padding:0 24px;border-radius:9999px;background:#B24E00;color:#FFFFFF;font-size:16px;font-weight:600;box-shadow:0 4px 12px rgba(0,0,0,.06),0 24px 56px rgba(0,0,0,.10);transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
  >WhatsApp</a
>

<div
  data-mobilebar
  style="position:fixed;left:0;right:0;bottom:0;z-index:80;background:rgba(255,255,255,0.94);backdrop-filter:blur(12px);border-top:1px solid rgba(0,0,0,0.08);padding:12px 16px;gap:12px;align-items:center"
>
  <a
    data-primary
    href={hrefCita}
    style="flex:1;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;border-radius:9999px;background:#B24E00;color:#FFFFFF;font-size:17px;font-weight:600"
    >Pide cita<span data-arrow style="display:inline-block;transition:transform 300ms cubic-bezier(0.22,1,0.36,1)">→</span></a
  >
  <a
    href={`tel:${CONTACTO.telefonoE164}`}
    aria-label={`Llama al ${CONTACTO.telefono}`}
    style="width:56px;height:56px;flex:none;border-radius:9999px;border:1px solid rgba(0,0,0,0.08);display:flex;align-items:center;justify-content:center;font-size:20px;color:#B24E00;background:#FFFFFF"
    >☏</a
  >
  {
    conWhatsAppEnBarra && (
      <a
        href={CONTACTO.whatsappUrl}
        aria-label="Escríbenos por WhatsApp"
        style="position:relative;width:56px;height:56px;flex:none;border-radius:9999px;border:1px solid rgba(0,0,0,0.08);display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:600;color:#B24E00;background:#FFFFFF"
      >
        WA
      </a>
    )
  }
</div>
