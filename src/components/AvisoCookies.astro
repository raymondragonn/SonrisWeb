---
// Consentimiento previo del art. 22.2 LSSI. El sitio no pone cookies propias:
// lo único que hay que consentir son los marcos de terceros (mapa de Google en
// Contacto, tour de Matterport en Sobre nosotros), que no se cargan hasta que
// se acepta. Rechazar cuesta un clic igual que aceptar, como pide la AEPD.
---

<dialog
  id="sonris-cookies"
  aria-labelledby="cookies-t"
  style="max-width:520px;width:calc(100% - 32px);border:0;border-radius:28px;padding:32px;background:#FFFFFF;color:#1A1A1A;box-shadow:0 4px 12px rgba(0,0,0,.06),0 24px 56px rgba(0,0,0,.14)"
>
  <h2
    id="cookies-t"
    style="margin:0 0 12px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:24px;line-height:1.2;letter-spacing:-0.02em;color:#000000"
  >
    Cookies de terceros
  </h2>
  <p style="margin:0 0 20px;font-size:16px;line-height:1.7;color:#6B6B6B">
    Esta web no usa cookies propias ni analítica. El mapa de Google y el tour virtual sí guardan cookies cuando se
    muestran, así que solo se cargan si los aceptas. Puedes cambiar de idea cuando quieras desde el pie de página.
  </p>
  <div style="display:flex;flex-wrap:wrap;gap:12px">
    <button
      type="button"
      data-cookies="aceptadas"
      data-primary
      style="display:inline-flex;flex:none;align-items:center;min-height:48px;padding:0 26px;border-radius:9999px;border:0;background:#E76B0B;color:#FFFFFF;font-family:inherit;font-size:18.66px;font-weight:600;cursor:pointer;transition:background 300ms var(--ease),box-shadow 300ms var(--ease)"
      >Aceptar</button
    >
    <button
      type="button"
      data-cookies="rechazadas"
      data-secondary
      style="display:inline-flex;flex:none;align-items:center;min-height:48px;padding:0 26px;border-radius:9999px;background:#FFFFFF;border:1px solid rgba(0,0,0,0.08);color:#1A1A1A;font-family:inherit;font-size:16px;font-weight:600;cursor:pointer;transition:background 300ms var(--ease),border-color 300ms var(--ease)"
      >Rechazar</button
    >
    <a
      data-underline
      href="/politica-de-cookies/"
      style="display:inline-flex;align-items:center;min-height:48px;font-size:15px;font-weight:500;color:#1A1A1A"
      >Política de cookies</a
    >
  </div>
</dialog>

<script>
  const CLAVE = 'sonris-cookies';
  // La AEPD pide renovar el consentimiento al menos cada 24 meses.
  const CADUCIDAD = 24 * 30 * 24 * 3600 * 1000;

  type Estado = 'aceptadas' | 'rechazadas' | null;

  const leer = (): Estado => {
    try {
      const g = JSON.parse(localStorage.getItem(CLAVE) || 'null');
      return g && Date.now() - g.ts < CADUCIDAD ? g.v : null;
    } catch {
      // Modo privado o almacenamiento bloqueado: sin consentimiento guardado.
      return null;
    }
  };

  const dlg = document.getElementById('sonris-cookies') as HTMLDialogElement | null;

  /** Los marcos de terceros nacen con data-src y solo reciben src al aceptar.
   *  Mientras tanto, en su hueco se pinta el aviso con el botón de carga. */
  function aplicar(estado: Estado) {
    document.querySelectorAll<HTMLIFrameElement>('iframe[data-src]').forEach((marco) => {
      const hueco = marco.parentElement;
      const aviso = hueco?.querySelector<HTMLElement>('[data-consent-aviso]');
      if (estado === 'aceptadas') {
        if (!marco.src) marco.src = marco.dataset.src as string;
        aviso?.remove();
        return;
      }
      // Retirar el consentimiento tiene que descargar lo ya cargado, no solo
      // afectar a la próxima visita.
      if (marco.src) marco.removeAttribute('src');
      if (aviso || !hueco) return;
      const caja = document.createElement('div');
      caja.dataset.consentAviso = '';
      caja.style.cssText =
        'position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:32px;text-align:center;background:#EFEFEF';
      const texto = document.createElement('p');
      texto.style.cssText = 'margin:0;font-size:16px;line-height:1.7;color:#6B6B6B;max-width:40ch';
      texto.textContent = `Este contenido lo aloja ${marco.dataset.proveedor || 'un tercero'} y guarda cookies en tu dispositivo al mostrarse.`;
      const boton = document.createElement('button');
      boton.type = 'button';
      boton.dataset.cookies = 'aceptadas';
      boton.dataset.primary = '';
      boton.textContent = 'Aceptar y mostrar';
      boton.style.cssText =
        'display:inline-flex;align-items:center;min-height:48px;padding:0 26px;border-radius:9999px;border:0;background:#E76B0B;color:#FFFFFF;font-family:inherit;font-size:18.66px;font-weight:600;cursor:pointer';
      caja.append(texto, boton);
      hueco.append(caja);
    });
  }

  function decidir(v: 'aceptadas' | 'rechazadas') {
    try {
      localStorage.setItem(CLAVE, JSON.stringify({ v, ts: Date.now() }));
    } catch {
      // Sin almacenamiento la decisión vale para esta página y se vuelve a preguntar.
    }
    dlg?.close();
    aplicar(v);
  }

  // Un solo oyente para los botones del diálogo y los de los huecos, que se
  // crean después.
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-cookies]');
    if (b) decidir(b.dataset.cookies as 'aceptadas' | 'rechazadas');
  });

  // Reabrir desde el pie para cambiar la decisión ya tomada.
  document.querySelectorAll('[data-abrir-cookies]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      dlg?.showModal();
    })
  );

  const guardado = leer();
  aplicar(guardado);
  // Cerrar con Escape no consiente nada: los marcos siguen sin cargarse y se
  // vuelve a preguntar en la próxima visita.
  if (!guardado) dlg?.showModal();
</script>
