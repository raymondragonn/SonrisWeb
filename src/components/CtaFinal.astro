---
import { CONTACTO } from '../data/site';

interface Props {
  titulo?: string;
  texto?: string;
  href?: string;
  etiqueta?: string;
}
const {
  titulo = '¿Empezamos?',
  texto,
  href = '/contacto/#formulario',
  etiqueta = 'Pide tu cita',
} = Astro.props;
---

<section data-sec id="formulario" aria-labelledby="cta-t" style="padding:112px 0">
  <div style="max-width:1240px;margin:0 auto;padding:0 40px">
    <div
      data-peach
      data-cta-caja
      style="background:#FEE1CB;border-radius:40px;padding:64px 56px;display:flex;flex-wrap:wrap;gap:32px;align-items:center;justify-content:space-between"
    >
      <div>
        <h2
          id="cta-t"
          style="margin:0;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:48px;line-height:1.05;letter-spacing:-0.02em;color:#000000;max-width:14ch"
        >
          {titulo}
        </h2>
        {texto && <p style="margin:12px 0 0;font-size:17px;line-height:1.7;color:#1A1A1A;max-width:52ch">{texto}</p>}
      </div>
      <div style="display:flex;flex-direction:column;gap:14px">
        <a
          data-primary
          href={href}
          style="display:inline-flex;white-space:nowrap;align-items:center;gap:12px;min-height:56px;padding:0 32px;border-radius:9999px;background:#B24E00;color:#FFFFFF;font-size:17px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
          >{etiqueta}<span data-arrow style="display:inline-block;transition:transform 300ms cubic-bezier(0.22,1,0.36,1)">→</span></a
        >
        <p style="margin:0;font-size:16px;color:#1A1A1A">
          o llámanos al <a href={`tel:${CONTACTO.telefonoE164}`} style="color:#B24E00;font-weight:500">{CONTACTO.telefono}</a>
        </p>
      </div>
    </div>
  </div>
</section>
