---
import { CONTACTO } from '../data/site';

interface Props {
  titulo?: string;
  texto?: string;
  href?: string;
  etiqueta?: string;
}
const {
  titulo = 'Cuéntanos qué te preocupa',
  texto = `Primera visita GRATUITA, sin compromiso. ${CONTACTO.horario}, en ${CONTACTO.calle}.`,
  href = '/contacto/',
  etiqueta = 'Reserva tu primera visita',
} = Astro.props;
---

<section data-sec data-fin-pagina id="formulario" aria-labelledby="cta-t" style="padding:112px 0 72px">
  <div style="max-width:1240px;margin:0 auto;padding:0 40px">
    <div
      data-peach
      data-cta-caja
      data-textura
      style="background-color:#FEE1CB;--velo:rgba(254,225,203,0.9);border-radius:40px;padding:56px;display:flex;flex-wrap:wrap;gap:32px;align-items:center;justify-content:space-between"
    >
      <div>
        <h2
          data-h2-grande
          id="cta-t"
          style="margin:0 0 12px;font-family:Poppins,system-ui,sans-serif;font-weight:600;font-size:40px;line-height:1.1;letter-spacing:-0.02em;color:#000000;max-width:22ch"
        >
          {titulo}
        </h2>
        {texto && <p style="margin:0;font-size:17px;line-height:1.7;color:#1A1A1A;max-width:52ch">{texto}</p>}
      </div>
      <div style="display:flex;flex-direction:column;gap:14px">
        <a
          data-primary
          href={href}
          style="display:inline-flex;white-space:nowrap;align-items:center;gap:12px;min-height:56px;padding:0 32px;border-radius:9999px;background:#E76B0B;color:#FFFFFF;font-size:18.66px;font-weight:600;transition:background 300ms cubic-bezier(0.22,1,0.36,1),box-shadow 300ms cubic-bezier(0.22,1,0.36,1)"
          >{etiqueta}<span data-arrow style="display:inline-block;transition:transform 300ms cubic-bezier(0.22,1,0.36,1)">→</span></a
        >
        <p style="margin:0;font-size:16px;color:#1A1A1A">
          o llámanos al <a href={`tel:${CONTACTO.telefonoE164}`} style="color:#E76B0B;font-weight:500">{CONTACTO.telefono}</a>
        </p>
      </div>
    </div>
    <slot />
  </div>
</section>
