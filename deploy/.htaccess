Redirect 301 /carillas-dentales/ /tratamientos/estetica-dental/#carillas
Redirect 301 /estetica-dental-2/ /tratamientos/estetica-dental/
Redirect 301 /endodoncia-2/ /tratamientos/endodoncia/
Redirect 301 /odontologia-general-2/ /tratamientos/odontologia-general/
Redirect 301 /implantes-dentales/ /tratamientos/implantes-dentales/
Redirect 301 /cirugia-ortognatica/ /tratamientos/cirugia-ortognatica/
Redirect 301 /cirugia-oral/ /tratamientos/cirugia-oral/
Redirect 301 /periodoncia/ /tratamientos/periodoncia/
Redirect 301 /contacto-sonris/ /contacto/
Redirect 301 /politica-privacidad/ /politica-de-privacidad/
Redirect 301 /financiacion-ortodoncia-invisible-madrid/ /contacto/
Redirect 301 /blog/ /
Redirect 301 /blog/ortodoncia-invisible-precio/ /contacto/
Redirect 301 /blog/cuanto-dura-la-ortodoncia-invisible/ /ortodoncia-invisible/#tipos
Redirect 301 /blog/invisalign-o-brackets/ /ortodoncia-invisible/#que-es
