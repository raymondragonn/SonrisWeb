Redirect 410 /identifica-tu-caso/

ErrorDocument 404 /404.html

# El modo edición reescribe el HTML al publicar: sin no-cache, el navegador
# podría seguir mostrando la versión anterior y el cambio no sería instantáneo.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
