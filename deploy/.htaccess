# Generado por scripts/generar-redirecciones.mjs. No editar a mano.
# Fuente: src/data/redirecciones.js
# 32 reglas 301 + 1 regla 410, más normalización de barra final y www.
DirectoryIndex index.html index.php
RewriteEngine On

# https y sin www. Solo con el dominio real: en local (Docker) se sirve por
# http://localhost y esta regla mandaría cada petición a producción.
RewriteCond %{HTTP_HOST} ^(www\.)?sonris\.es$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://sonris.es/$1 [R=301,L]

# Modo edición: sin acceso directo al código ni a los datos editados.
RewriteRule ^(storage|lib|bin|tests|cms-plantillas)(/|$) - [F,L]

# URLs limpias del acceso de administrador, antes de la barra final.
RewriteRule ^alta/?$ api/alta.php [L]
RewriteRule ^entrar/?$ api/entrar.php [L]
RewriteRule ^salir/?$ api/salir.php [L]

# Barra final obligatoria.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

Redirect 301 /como-ponerse-el-alineador/ /ortodoncia-invisible/#como-funciona
Redirect 301 /primera-consulta-gratuita/ /ortodoncia-invisible/#primera-visita
